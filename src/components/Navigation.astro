---
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, support } from '../data/site';
const { compact = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href.startsWith('/#') ? false : href === path);
const onSupport = path.startsWith('/support');
---
<header class="site-header">
  <div class="bar">
    <a class="home" href="/" aria-label="Aditya Aswani, home"><Wordmark label={false} /></a>
    <div class="tools">
      <a class="support-btn" href={support.href} aria-current={onSupport ? 'page' : undefined}>
        <span aria-hidden="true" class="full">{support.label}</span><span aria-hidden="true" class="short">{support.short}</span><span class="sr-only">{support.label}</span>
      </a>
      <ThemeToggle />
    </div>
  </div>
  {!compact && <nav aria-label="Main">
    <ul>
      {nav.map((n) => <li><a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
  </nav>}
</header>
<style>
  .site-header { max-width: calc(var(--measure) + 2 * var(--pad)); margin-inline: auto; padding: 0.75rem var(--pad) 0; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 56px; }
  .home { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); text-decoration: none; }
  .home :global(.wordmark) { height: 1.45rem; }
  .tools { display: flex; align-items: center; gap: .25rem; }
  .support-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border: 1px solid var(--accent); color: var(--accent); text-decoration: none; font-variant-caps: all-small-caps; letter-spacing: .09em; transition: background-color .2s, color .2s; }
  .support-btn:hover, .support-btn[aria-current] { background: var(--accent); color: var(--accent-ink); }
  .short { display: none; }
  nav { border-bottom: 1px solid var(--rule); }
  nav ul { display: flex; flex-wrap: wrap; column-gap: 1.6rem; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; font-variant-caps: all-small-caps; letter-spacing: .09em; color: var(--muted); font-size: 1.02em; transition: color .2s; }
  nav a:hover { color: var(--ink); }
  nav a[aria-current] { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: .35em; }
  @media (max-width: 520px) { .full { display: none; } .short { display: inline; } .support-btn { padding: 0 .85rem; } }
</style>
