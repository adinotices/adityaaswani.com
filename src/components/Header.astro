---
import Wordmark from './Wordmark.astro';
import { nav, support } from '../data/site';
export interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const onHome = path === '/';
const supportCurrent = path.startsWith('/support');
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Aditya Aswani, home">
      <Wordmark mark class="brand-mark" />
      <Wordmark class="brand-name" />
    </a>
    {!compact && (
      <nav class="primary" aria-label="Primary">
        <ul>
          {nav.map((n) => (
            <li><a href={onHome && n.href.startsWith('/#') ? n.href.slice(1) : n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <div class="actions">
      <a class="support-btn" href={support.href} aria-current={supportCurrent ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        <span class="full">{support.label}</span>
        <span class="short" aria-hidden="true">{support.short}</span>
        <span class="sr-only short-sr">{support.label}</span>
      </a>
      <button type="button" class="theme-toggle" aria-pressed="false" aria-label="Dark mode">
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M21 14.5A9 9 0 0 1 9.5 3a9 9 0 1 0 11.5 11.5z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; min-height: 64px;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar { min-height: 64px; display: flex; align-items: center; flex-wrap: wrap; gap: 0 1.25rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--text); text-decoration: none; min-height: 44px; flex: none; }
  .brand :global(.brand-mark) { width: 30px; height: auto; color: var(--accent); display: none; }
  .brand :global(.brand-name) { width: 148px; height: auto; }
  .brand:hover :global(.brand-mark) { transform: translateY(-1px); }
  .brand :global(.brand-mark) { transition: transform 0.2s; }
  .primary { margin-left: auto; }
  .primary ul { display: flex; gap: 0.15rem; }
  .primary a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.75rem; border-radius: 8px;
    color: var(--muted); font-size: 0.94rem; font-weight: 500; text-decoration: none; transition: color 0.15s, background 0.15s;
  }
  .primary a:hover { color: var(--text); background: var(--surface-2); }
  .primary a[aria-current="page"] { color: var(--text); }
  .actions { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }
  .primary + .actions { margin-left: 0; }
  .support-btn {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 40px; padding: 0 0.9rem; border-radius: 10px;
    background: var(--accent); color: var(--accent-ink); font-weight: 650; font-size: 0.92rem; text-decoration: none;
    transition: box-shadow 0.18s, transform 0.18s;
  }
  .support-btn:hover { box-shadow: var(--shadow-hover); transform: translateY(-1px); text-decoration: none; }
  .support-btn .short { display: none; }
  .theme-toggle {
    width: 40px; height: 40px; border-radius: 10px; border: 1.5px solid var(--line-strong); background: var(--surface);
    color: var(--text); display: grid; place-items: center; cursor: pointer; transition: border-color 0.15s;
  }
  .theme-toggle:hover { border-color: var(--text); }
  .i-sun { display: none; }
  :global(:root[data-theme="dark"]) .i-sun { display: block; }
  :global(:root[data-theme="dark"]) .i-moon { display: none; }

  @media (max-width: 899px) {
    .primary { order: 3; flex: 0 0 100%; margin: 0 0 4px; }
    .primary ul { justify-content: space-between; max-width: 30rem; }
    .primary a { padding: 0 0.45rem; font-size: 0.9rem; min-height: 40px; }
  }
  @media (max-width: 520px) {
    .brand :global(.brand-name) { display: none; }
    .brand :global(.brand-mark) { display: block; }
    .bar { gap: 0.6rem; }
    .support-btn .full { display: none; }
    .support-btn .short { display: inline; }
    .brand { margin-right: auto; }
  }
  @media (max-width: 899px) { .actions { margin-left: auto; } }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;
  const sync = () => btn?.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'dark'));
  sync();
  btn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
    sync();
  });
</script>
