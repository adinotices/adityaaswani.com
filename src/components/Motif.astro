    <path d="M28 22c0-3 2-5 4-5s4 2 4 5"/>
    <path d="M32 12c-1-2 0-4 2-5" stroke-width="2"/>
  </>)}
  {slug === 'savethedogs' && (<>
    <path d="M32 54c-12-9-20-15-20-24 0-6 4-10 9-10 4 0 9 3 11 8 2-5 7-8 11-8 5 0 9 4 9 10 0 9-8 15-20 24z"/>
    <path d="M14 24c-4-2-6-8-4-14 5 0 9 4 11 9M50 24c4-2 6-8 4-14-5 0-9 4-11 9" stroke-width="2.2"/>
    <circle cx="26" cy="32" r="1.4" fill="currentColor"/><circle cx="38" cy="32" r="1.4" fill="currentColor"/>
    <path d="M29 39c2 2 4 2 6 0" stroke-width="2"/>
  </>)}
</svg>
