    <path d="M26 10c2-3 4-3 6 0 2-3 4-3 6 0" stroke-width="2"/>
  </>)}
  {slug === 'pausepal' && (<>
    <path d="M10 34c0 10 7 17 15 17s14-7 14-17z"/>
    <path d="M39 38h3c5 0 5 8 0 8h-4"/>
    <path d="M43 30c0 10 5 15 11 15"/>
    <path d="M18 24c-2-3 2-5 0-9M27 24c-2-3 2-5 0-9" stroke-width="2"/>
    <path d="M46 20c-2 0-4 2-4 4 0 3 4 5 4 5s4-2 4-5c0-2-2-4-4-4z" stroke-width="2"/>
