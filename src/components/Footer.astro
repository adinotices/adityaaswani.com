---
import Wordmark from './Wordmark.astro';
import { nav, support, socials, identity } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="who">
        <a href="/" class="brand" aria-label="Aditya Aswani, home"><Wordmark class="foot-mark" /></a>
        <p class="blessing">{identity.blessing}</p>
        <a class="btn btn-primary" href={support.href}>{support.label}</a>
      </div>
      <nav aria-label="Footer">
        <h2 class="mono col-h">Site</h2>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={support.href}>{support.label}</a></li>
        </ul>
      </nav>
      <nav aria-label="Elsewhere">
        <h2 class="mono col-h">Elsewhere</h2>
        <ul class="socials">
          {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}
        </ul>
      </nav>
    </div>
    <p class="legal mono">© {year} {identity.name}</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--surface); padding: 3.5rem 0 2rem; margin-top: 4rem; }
  .top { display: grid; gap: 2.5rem; grid-template-columns: 1fr; }
  @media (min-width: 800px) { .top { grid-template-columns: 1.4fr 0.8fr 1.2fr; gap: 3rem; } }
  .brand { display: inline-block; color: var(--text); }
  .brand :global(.foot-mark) { width: 190px; height: auto; }
  .blessing { color: var(--muted); margin: 1rem 0 1.25rem; max-width: 22rem; }
  .col-h { text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 500; margin-bottom: 0.6rem; }
  .site-footer nav ul a { display: inline-flex; min-height: 36px; align-items: center; color: var(--text); text-decoration: none; }
  .site-footer nav ul a:hover { color: var(--accent-text); text-decoration: underline; }
  .socials { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1rem; }
  .legal { margin-top: 2.5rem; color: var(--muted); }
</style>
