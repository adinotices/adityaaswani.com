---
import Wordmark from './Wordmark.astro';
import { identity, nav, support, socials } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="who">
        <a class="brand" href="/" aria-label="Aditya Aswani, home"><Wordmark class="wm" label="" /></a>
        <p class="blessing">{identity.blessing}</p>
      </div>
      <nav aria-label="Footer">
        <ul class="links">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={support.href}>{support.label}</a></li>
        </ul>
      </nav>
    </div>
    <nav aria-label="Elsewhere online">
      <ul class="socials">
        {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}
      </ul>
    </nav>
    <p class="copy">&copy; {year} Aditya Aswani</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--bg-soft); border-top: 1px solid var(--line); padding: 3rem 0 2rem; margin-top: 2rem; }
  .top { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
  .brand { display: inline-flex; min-height: 44px; align-items: center; color: var(--ink); }
  :global(.wm) { height: 40px; width: auto; }
  .blessing { font-family: var(--serif); font-variation-settings: "SOFT" 100; font-size: 1.15rem; color: var(--ink-2); margin-top: 0.4rem; max-width: 22rem; }
  ul { list-style: none; display: flex; flex-wrap: wrap; }
  .links { gap: 0.2rem 0.4rem; }
  .links a, .socials a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.7rem; color: var(--ink);
    font-weight: 700; text-decoration: none; border-radius: 999px;
  }
  .links a:hover, .socials a:hover { background: var(--card); color: var(--clay-ink); }
  .socials { gap: 0 0.1rem; margin-inline: -0.7rem; padding-top: 1rem; border-top: 1px dashed var(--line); }
  .socials a { font-weight: 600; color: var(--ink-2); font-size: 0.95rem; }
  .copy { color: var(--ink-2); font-size: 0.9rem; margin-top: 1.2rem; }
</style>
