---
import Wordmark from './Wordmark.astro';
import { identity, nav, support, socials } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="inner">
    <a class="home" href="/" aria-label="Aditya Aswani, home"><Wordmark label={false} /></a>
    <p class="blessing">{identity.blessing}</p>
    <nav aria-label="Footer">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href={support.href}>{support.label}</a></li>
      </ul>
    </nav>
    <nav aria-label="Elsewhere">
      <ul class="soc">
        {socials.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}
      </ul>
    </nav>
    <p class="copy label">© {year} {identity.name}</p>
  </div>
</footer>
<style>
  .site-footer { margin-top: clamp(3rem, 8vw, 6rem); border-top: 1px solid var(--rule); }
  .inner { max-width: calc(var(--measure) + 2 * var(--pad)); margin-inline: auto; padding: 2.5rem var(--pad) 3rem; display: grid; gap: 1.25rem; }
  .home { color: var(--ink); text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; justify-self: start; }
  .home :global(.wordmark) { height: 1.3rem; }
  .blessing { font-style: italic; color: var(--muted); }
  ul { display: flex; flex-wrap: wrap; column-gap: 1.4rem; }
  .soc { column-gap: 1.1rem; }
  a { display: inline-flex; align-items: center; min-height: 36px; text-decoration: none; color: var(--ink); font-size: .95em; }
  nav:first-of-type a { font-variant-caps: all-small-caps; letter-spacing: .09em; font-size: 1.02em; }
  .soc a { color: var(--muted); }
  a:hover { color: var(--accent); text-decoration: underline; }
  .copy { font-size: .95em; }
</style>
