---
// "Copy" button for an email address. Hidden until JS confirms the clipboard API exists.
export interface Props { text: string; id: string }
const { text, id } = Astro.props;
const statusId = `${id}-status`;
---
<button type="button" class="copy-btn" data-copy={text} data-status={statusId} hidden>
  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
  <span class="copy-label">Copy</span><span class="sr-only"> {text}</span>
</button>
<span class="sr-only" id={statusId} role="status"></span>

<script>
  import { initCopyButtons } from '../scripts/copy-email.js';
  initCopyButtons({ root: document, clipboard: navigator.clipboard });
</script>

<style>
  .copy-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 44px; min-width: 44px;
    padding: 0 0.9rem; border-radius: 999px; border: 2px solid var(--ink-2); background: transparent; color: var(--ink);
    font: inherit; font-size: var(--fs-small); font-weight: 700; cursor: pointer; vertical-align: middle;
  }
  .copy-btn:hover { background: var(--bg-soft); border-color: var(--ink); }
  .copy-btn[hidden] { display: none; }
</style>
