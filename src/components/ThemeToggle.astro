<button type="button" class="theme-toggle" aria-pressed="false" aria-label="Dark mode">
  <svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
  <svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
</button>

<script>
  import { initThemeToggles } from '../scripts/theme-toggle.js';
  initThemeToggles({
    root: document.documentElement,
    buttons: [...document.querySelectorAll<HTMLButtonElement>('.theme-toggle')],
    storage: localStorage,
  });
</script>

<style>
  .theme-toggle {
    width: 44px; height: 44px; display: inline-grid; place-items: center; border-radius: 50%;
    background: var(--card); color: var(--ink); border: 1px solid var(--line); cursor: pointer;
  }
  .theme-toggle:hover { background: var(--bg-soft); }
  .i-sun { display: none; }
  :global(:root[data-theme="dark"]) .i-sun { display: block; }
  :global(:root[data-theme="dark"]) .i-moon { display: none; }
</style>
