---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import supportLinks from '../../data/support-links.json';

const { portalUrl, monthly } = supportLinks;
const monthly5 = monthly.tiers.find((t) => t.cents === 500) ?? monthly.tiers[0];
---

<Layout title="Thank you — Aditya Aswani" description="Thank you for supporting Aditya Aswani's work." noindex>
  <Navigation />

  <main class="thanks-page">
    <article class="content">
      <h1>Thank you 🙏</h1>
      <p class="lead">Your support keeps the talks searchable, the meditation buddies matched and the campaign going. It means a lot to me.</p>
      <p>It goes straight into hosting, the GPUs that transcribe Dhamma talks, and time to build the next free thing.</p>

      <p id="monthly-note" hidden>You can <a href={portalUrl}>manage or cancel your monthly support</a> anytime.</p>

      <section id="upsell" class="card" aria-labelledby="upsell-heading" hidden>
        <h2 id="upsell-heading">Would you like to give $5 a month from now on?</h2>
        <div class="actions">
          <a class="primary" href={monthly5.url}>Yes, give $5 a month</a>
          <button type="button" class="plain" id="upsell-no">No thanks, this is perfect</button>
        </div>
      </section>

      <section class="card" aria-labelledby="share-heading">
        <h2 id="share-heading">Know someone who'd like this work?</h2>
        <button type="button" class="primary" id="share-btn">Share this page</button>
        <p class="status" id="share-status" role="status" aria-live="polite"></p>
      </section>

      <p class="blessing">May you be happy, healthy, and safe.</p>
      <a href="/" class="home-button">Back to home</a>
    </article>
  </main>

  <Footer />
</Layout>

<script>
  const type = new URLSearchParams(location.search).get('type');
  const show = (id: string) => { document.getElementById(id)!.hidden = false; };
  if (type === 'once') show('upsell');
  if (type === 'monthly') show('monthly-note');

  document.getElementById('upsell-no')!.addEventListener('click', () => {
    document.getElementById('upsell')!.hidden = true;
  });

  const status = document.getElementById('share-status')!;
  document.getElementById('share-btn')!.addEventListener('click', async () => {
    const url = 'https://adityaaswani.com/support';
    if (navigator.share) {
      try { await navigator.share({ url }); } catch { /* dismissed */ }
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      status.textContent = 'Link copied';
    } catch {
      status.textContent = 'Copy this link: ' + url;
    }
  });
</script>

<style>
  .thanks-page {
    min-height: 80vh;
    padding-top: calc(4rem + 80px);
  }

  .content {
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .lead {
    font-size: 1.25rem;
  }

  p a {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .blessing {
    color: var(--text-primary);
    font-weight: 500;
    font-size: 1.1rem;
  }

  [hidden] { display: none !important; }

  .card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .card h2 {
    color: var(--text-primary);
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .primary, .plain {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .primary { background: #4f46e5; color: #ffffff; border: 2px solid #4f46e5; }
  .primary:hover { background: #4338ca; }
  .plain { background: transparent; color: var(--text-primary); border: 2px solid var(--text-secondary); }
  .plain:hover { border-color: var(--text-primary); }

  .primary:focus-visible, .plain:focus-visible, .home-button:focus-visible {
    outline: 3px solid var(--accent-hover);
    outline-offset: 3px;
  }

  .status { margin: 0.75rem 0 0; min-height: 1.5em; color: var(--text-primary); }

  .home-button {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 10px;
    background: #4f46e5;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .home-button:hover {
    background: #4338ca;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .thanks-page {
      padding-top: calc(2rem + 90px);
    }
  }
</style>
