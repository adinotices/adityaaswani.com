---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import supportLinks from '../../data/support-links.json';

const { portalUrl, monthly } = supportLinks;
const monthly5 = monthly.tiers.find((t) => t.cents === 500) ?? monthly.tiers[0];
---

<Layout title="Thank you — Aditya Aswani" description="Thank you for supporting Aditya Aswani's work." noindex>
  <Navigation />

  <main id="main" class="thanks-page">
    <article class="content">
      <h1>Thank you 🙏</h1>
      <p class="lead">Your support keeps the talks searchable, the meditation buddies matched and the campaign going. It means a lot to me.</p>
      <p>It goes straight into hosting, the GPUs that transcribe Dhamma talks, and time to build the next free thing.</p>

      <p id="monthly-note" hidden>You can <a href={portalUrl}>manage or cancel your monthly support</a> anytime.</p>

      <section id="upsell" class="card" aria-labelledby="upsell-heading" hidden>
        <h2 id="upsell-heading">Would you like to give $5 a month from now on?</h2>
        <div class="actions">
          <a class="primary" href={monthly5.url}>Yes, give $5 a month</a>
          <button type="button" class="plain" id="upsell-no">No thanks, this is perfect</button>
        </div>
      </section>

      <section class="card" aria-labelledby="share-heading">
        <h2 id="share-heading">Know someone who'd like this work?</h2>
        <button type="button" class="primary" id="share-btn">Share this page</button>
        <p class="status" id="share-status" role="status" aria-live="polite"></p>
      </section>

      <p class="blessing">May you be happy, healthy, and safe.</p>
      <a href="/" class="home-button">Back to home</a>
    </article>
  </main>

  <Footer />
</Layout>

<script>
  const type = new URLSearchParams(location.search).get('type');
  const show = (id: string) => { document.getElementById(id)!.hidden = false; };
  if (type === 'once') show('upsell');
  if (type === 'monthly') show('monthly-note');

  document.getElementById('upsell-no')!.addEventListener('click', () => {
    document.getElementById('upsell')!.hidden = true;
  });

  const status = document.getElementById('share-status')!;
  document.getElementById('share-btn')!.addEventListener('click', async () => {
    const url = 'https://adityaaswani.com/support';
    if (navigator.share) {
      try { await navigator.share({ url }); } catch { /* dismissed */ }
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      status.textContent = 'Link copied';
    } catch {
      status.textContent = 'Copy this link: ' + url;
    }
  });
</script>

<style>
  [hidden] { display: none !important; }
  .thanks-page { padding-block: clamp(2.5rem, 7vw, 5rem) 1rem; }
  .content { max-width: calc(var(--measure) + 2 * var(--pad)); margin-inline: auto; padding-inline: var(--pad); }
  h1 { font-size: clamp(2.4rem, 1.6rem + 3.4vw, 3.6rem); font-weight: 380; margin-bottom: 1rem; }
  p { color: var(--muted); margin-bottom: 1.25rem; }
  .lead { font-size: 1.3em; font-style: italic; line-height: 1.45; }
  p a { color: var(--ink); }
  p a:hover { color: var(--accent); }
  .blessing { color: var(--ink); font-style: italic; font-size: 1.15em; margin-top: 2rem; }
  .card { padding-block: 1.5rem; border-top: 1px solid var(--rule); margin-top: 1.5rem; }
  .card h2 { font-size: 1.3em; font-weight: 450; margin-bottom: 1rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .primary, .plain { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: .4rem 1.5rem; font: inherit; font-variant-caps: all-small-caps; letter-spacing: .09em; text-decoration: none; cursor: pointer; border: 1px solid var(--ink); transition: background-color .2s, color .2s, border-color .2s; }
  .primary { background: var(--ink); color: var(--paper); }
  .primary:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .plain { background: transparent; color: var(--ink); }
  .plain:hover { background: var(--ink); color: var(--paper); }
  .status { margin: .75rem 0 0; min-height: 1.5em; color: var(--ink); }
  .home-button { display: inline-flex; align-items: center; min-height: 48px; padding: .4rem 1.5rem; border: 1px solid var(--ink); text-decoration: none; font-variant-caps: all-small-caps; letter-spacing: .09em; transition: background-color .2s, color .2s; }
  .home-button:hover { background: var(--ink); color: var(--paper); }
</style>
