---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import supportLinks from '../../data/support-links.json';
import { feeCents, fmt } from '../../scripts/donate.js';

const isTest = supportLinks.mode === 'test';
const { fees, oneTime, monthly, checkout } = supportLinks;

// Editable copy: the line shown under the amount ladder for each selection.
const impact = {
  monthly: {
    300: "Small and steady. Steady is what lets me plan.",
    500: "About a coffee a month. Ten of these cover all the hosting.",
    1000: "Covers a real share of the hosting, and the rest goes to time.",
    2500: "Mostly time: hours each month for the animals or the practice instead of paid work.",
  },
  once: {
    500: "A thank-you. It goes into the shared hosting pot.",
    1000: "About a week of server costs across the projects.",
    2500: "Goes toward time for the work.",
    5000: "A meaningful block of time for the animals or the practice.",
    other: "Every amount goes to the same place: servers first, then time.",
  },
};

// Build-time guard: the fee shown for every preset must match the Payment Link tier.
for (const t of monthly.tiers) {
  if (t.cents + feeCents(t.cents) !== t.feeCents) {
    throw new Error(`support-links.json tier ${t.cents}: feeCents ${t.feeCents} != computed ${t.cents + feeCents(t.cents)}`);
  }
}

const defaultTier = monthly.tiers.find((t) => t.cents === monthly.defaultCents) ?? monthly.tiers[0];
const defaultFee = feeCents(defaultTier.cents);
const clientConfig = { oneTime, monthly, impact };

const groups = [
  {
    heading: "Fighting for animals",
    intro: "I take part in open rescue and public campaigns to get animals out of laboratories and breeding facilities, and I have faced criminal charges for it.",
    items: [
      {
        title: "Ridglan Farms",
        description: "I helped free the beagles kept for experimentation at Ridglan Farms in Wisconsin. Ridglan has since shut down.",
        link: "https://savethedogs.io/"
      },
      {
        title: "Marshall BioResources",
        description: "The campaign I am working on now: freeing the roughly 16,000 beagles bred for laboratories at Marshall BioResources.",
        link: "https://savethedogs.io/"
      },
    ],
  },
  {
    heading: "Spreading mindfulness",
    intro: "I work on programs and tools that help people start a practice and keep it.",
    items: [
      {
        title: "Contemplative Semester",
        description: "A semester-long residential program for young adults built around meditation, study and community. I serve as Operations Lead.",
        link: "https://www.contemplativesemester.org/"
      },
      {
        title: "Inward Bound",
        description: "Mindfulness retreats and programs for teens and young adults that I work with.",
        link: "https://ibme.com/"
      },
      {
        title: "PausePal",
        description: "Meditate with a buddy at a fixed weekly time, so the practice sticks.",
        link: "https://pausepal.co/"
      },
      {
        title: "Sutam",
        description: "Search across thousands of Dhamma talks, transcribed so you can find the teaching you need.",
        link: "https://sutam.org/"
      },
    ],
  },
];
---

<Layout title="Support my work — Aditya Aswani" description="Support Aditya Aswani's work fighting for animal rights, from the Ridglan Farms beagles to Marshall BioResources, and spreading mindfulness through Contemplative Semester, Inward Bound, PausePal and Sutam." ogImage="/og-default.jpg">
  <Header />

  <main id="main" tabindex="-1" class="page">
    <script is:inline>document.documentElement.classList.add('js');</script>
    <article class="wrap--narrow">
      <header class="page-header">
        {isTest && <p class="test-badge">Test mode: no real charges</p>}
        <h1>Support my work</h1>
        <p class="lead">I spend my time on two things: fighting for animals and helping people build a steady mindfulness practice. The servers are cheap and the campaign costs are covered by the coalition. What your support really buys is my time.</p>
      </header>

      <section class="give-card" aria-labelledby="give-heading" id="give" data-config={JSON.stringify(clientConfig)}>
        <h2 id="give-heading" class="sr-only">Give</h2>

        <div class="js-only controls">
          <fieldset class="freq">
            <legend class="sr-only">Frequency</legend>
            <label class="tab"><input type="radio" name="freq" value="monthly" checked /><span>Monthly</span></label>
            <label class="tab"><input type="radio" name="freq" value="once" /><span>One-time</span></label>
          </fieldset>

          <p class="callout" id="callout">Monthly support helps most, because I can plan around it. Cancel anytime.</p>

          <fieldset class="ladder" id="ladder-monthly">
            <legend>Monthly amount</legend>
            <div class="options">
              {monthly.tiers.map((t) => (
                <label class="opt">
                  <input type="radio" name="m-amt" value={t.cents} checked={t.cents === monthly.defaultCents} />
                  <span class="opt-face">
                    <span class="opt-amt">{fmt(t.cents)}<small>/month</small></span>
                    {t.cents === monthly.defaultCents && <span class="tag">Suggested</span>}
                  </span>
                </label>
              ))}
              <label class="opt">
                <input type="radio" name="m-amt" value="other" />
                <span class="opt-face"><span class="opt-amt">Other</span></span>
              </label>
            </div>
          </fieldset>

          <fieldset class="ladder" id="ladder-once" hidden>
            <legend>One-time amount</legend>
            <div class="options">
              {oneTime.amounts.map((c) => (
                <label class="opt">
                  <input type="radio" name="o-amt" value={c} checked={c === oneTime.defaultCents} />
                  <span class="opt-face">
                    <span class="opt-amt">{fmt(c)}</span>
                    {c === oneTime.defaultCents && <span class="tag">Suggested</span>}
                  </span>
                </label>
              ))}
              <label class="opt">
                <input type="radio" name="o-amt" value="other" />
                <span class="opt-face"><span class="opt-amt">Other</span></span>
              </label>
            </div>
          </fieldset>

          <div class="other" id="other-wrap" hidden>
            <label for="other-amount">Other amount (USD)</label>
            <div class="other-row">
              <span aria-hidden="true">$</span>
              <input id="other-amount" type="number" inputmode="decimal" min="1" max="1000" step="0.01" aria-describedby="other-error" />
            </div>
            <p class="error" id="other-error" aria-live="polite"></p>
          </div>

          <p class="impact" id="impact" aria-live="polite">{impact.monthly[monthly.defaultCents]}</p>

          <div class="fee">
            <label class="fee-label">
              <input type="checkbox" id="fee-cb" />
              <span id="fee-text">Add {fmt(defaultFee)} to cover card fees, so the full {fmt(defaultTier.cents)} reaches me</span>
            </label>
            <p class="helper">Card fees are about {fees.percent}% + {fees.fixedCents}¢.</p>
          </div>
        </div>

        <a id="give-btn" class="give-button" href={defaultTier.url}>Give {fmt(defaultTier.cents)} a month</a>
        <p id="give-status" class="give-status" role="status"></p>

        <p class="secure">
          Secure checkout by Stripe.
          <span id="cancel-note"> Cancel anytime: <a href={checkout.portalUrl}>manage or cancel</a>.</span>
        </p>

        <p class="deductible">This is personal support for my independent work, not a charitable donation, so it isn't tax-deductible. Thank you for backing it.</p>

        <noscript>
          <div class="noscript-links">
            <p>Choose an option:</p>
            <ul>
              <li>One-time, any amount: <a href={oneTime.url}>give once</a></li>
              {monthly.tiers.map((t) => (
                <li>
                  {fmt(t.cents)} a month: <a href={t.url}>give {fmt(t.cents)} monthly</a>, or <a href={t.feeUrl}>give {fmt(t.feeCents)} monthly (covers card fees)</a>
                </li>
              ))}
            </ul>
            <p>A custom monthly amount needs JavaScript; the one-time link lets you choose any amount.</p>
          </div>
        </noscript>
      </section>

      <section class="why" aria-labelledby="why-heading">
        <h2 id="why-heading">What your support makes possible</h2>
        {groups.map(group => (
          <div class="group">
            <h3>{group.heading}</h3>
            <p class="group-intro">{group.intro}</p>
            <ul class="project-list">
              {group.items.map(project => (
                <li>
                  {project.link
                    ? <a href={project.link} target="_blank" rel="noopener noreferrer">{project.title}</a>
                    : <span class="project-name">{project.title}</span>}{' '}
                  <span class="project-desc">{project.description}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <p class="fine-print">Questions? Email <a href="mailto:hello@adityaaswani.com">hello@adityaaswani.com</a>.</p>

      <p class="blessing">Thank you. May your generosity come back to you many times over.</p>
    </article>
  </main>

  <Footer />
</Layout>

<script>
  import { parseAmount, feeCents, fmt, nearestLine, startCheckout, errorMessage } from '../../scripts/donate.js';

  const $ = (id) => document.getElementById(id);
  const cfg = JSON.parse($('give').dataset.config);
  const { oneTime, monthly, impact } = cfg;
  const checked = (name) => document.querySelector(`input[name="${name}"]:checked`);
  // Write text only when it changes. Typing an Other amount and then clicking Give fires `change`
  // between mousedown and mouseup; replacing the text node under the pointer then makes WebKit drop
  // the click, so Safari needed two presses (FEATURES.md GIVE-06).
  const setText = (el, s) => { if (el.textContent !== s) el.textContent = s; };

  const btn = $('give-btn');
  const feeCb = $('fee-cb');
  const otherInput = $('other-amount');
  const otherErr = $('other-error');
  const statusEl = $('give-status');

  // With JS the button never navigates by href, so middle-click or copy-link can't bypass the Worker.
  btn.removeAttribute('href');
  btn.setAttribute('role', 'button');
  btn.setAttribute('tabindex', '0');

  let busy = false;
  let current = null; // { base, total, interval, tier, isCustom }

  function render() {
    const isMonthly = checked('freq').value === 'monthly';
    const interval = isMonthly ? 'month' : 'once';
    $('ladder-monthly').hidden = !isMonthly;
    $('ladder-once').hidden = isMonthly;
    $('callout').hidden = !isMonthly;
    $('cancel-note').hidden = !isMonthly;

    const v = checked(isMonthly ? 'm-amt' : 'o-amt').value;
    const isOther = v === 'other';
    $('other-wrap').hidden = !isOther;

    let base = null;
    let tier = null;
    if (isOther) {
      const parsed = parseAmount(otherInput.value);
      if (parsed.ok) base = parsed.cents;
      const showErr = !parsed.ok && !parsed.empty;
      setText(otherErr, showErr ? parsed.error : '');
      otherInput.setAttribute('aria-invalid', showErr ? 'true' : 'false');
    } else {
      base = Number(v);
      if (isMonthly) tier = monthly.tiers.find((t) => t.cents === base) || null;
    }

    const lines = isMonthly ? impact.monthly : impact.once;
    let line;
    if (base === null) line = impact.once.other;
    else if (!isOther) line = lines[base] || impact.once.other;
    else {
      const tiers = {};
      for (const k of Object.keys(lines)) if (k !== 'other') tiers[k] = lines[k];
      line = nearestLine(tiers, base, impact.once.other);
    }
    setText($('impact'), line);

    if (base === null) {
      current = null;
      setText($('fee-text'), 'Add card fees to my gift, so the full amount reaches me');
      if (!busy) setText(btn, 'Enter an amount');
      btn.setAttribute('aria-disabled', 'true');
      return;
    }
    const fee = feeCb.checked ? feeCents(base) : 0;
    const total = base + fee;
    current = { base, total, interval, tier, isCustom: isOther };
    setText($('fee-text'), `Add ${fmt(feeCents(base))} to cover card fees, so the full ${fmt(base)} reaches me`);
    if (!busy) {
      setText(btn, `Give ${fmt(total)} ${isMonthly ? 'a month' : 'once'}`);
      btn.removeAttribute('aria-disabled');
    }
  }

  function onChange() {
    setText(statusEl, '');
    render();
  }

  function fallbackUrl(c) {
    if (c.interval === 'once') return `${oneTime.url}?prefilled_amount=${c.total}`;
    if (c.tier) return feeCb.checked ? c.tier.feeUrl : c.tier.url;
    return null;
  }

  function setBusy(on) {
    busy = on;
    if (on) {
      btn.textContent = 'Opening secure checkout…';
      btn.setAttribute('aria-disabled', 'true');
      btn.setAttribute('aria-busy', 'true');
    } else {
      btn.removeAttribute('aria-busy');
      render();
    }
  }

  async function give() {
    if (busy || !current || btn.getAttribute('aria-disabled') === 'true') return;
    const c = current;
    statusEl.textContent = '';
    setBusy(true);
    const res = await startCheckout({
      site: 'aditya',
      amount_cents: c.base,
      interval: c.interval,
      cover_fees: feeCb.checked,
    });
    if (res.ok) {
      location.assign(res.url);
      return;
    }
    setBusy(false);
    statusEl.textContent = errorMessage(res.error);
    if (res.error !== 'invalid_amount' && res.error !== 'rate_limited') {
      const href = fallbackUrl(c);
      if (href) {
        statusEl.append(' ');
        const a = document.createElement('a');
        a.href = href;
        a.textContent = 'Or use this direct link';
        statusEl.append(a);
      } else {
        statusEl.append(' Custom monthly amounts need secure checkout; please try again in a moment or pick a preset.');
      }
    }
  }

  btn.addEventListener('click', (e) => {
    e.preventDefault();
    give();
  });
  btn.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      give();
    }
  });
  document.querySelectorAll('.controls input').forEach((el) => {
    el.addEventListener('change', onChange);
    el.addEventListener('input', onChange);
  });
  // Coming back from Stripe via bfcache restores the page mid-"busy".
  window.addEventListener('pageshow', () => {
    if (busy) setBusy(false);
  });
  render();
</script>

<style>
  [hidden] { display: none !important; }
  main:focus { outline: none; }
  :global(html:not(.js)) .js-only { display: none; }

  .test-badge { display: inline-block; margin-bottom: 1rem; padding: 0.25rem 0.8rem; border-radius: 999px; border: 1px solid #8a4a07; background: #fdebc3; color: #5c2f00; font-size: var(--fs-caption); font-weight: 800; }

  .give-card, .why {
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow);
    padding: clamp(1.25rem, 4vw, 2.2rem); margin-bottom: 2rem;
  }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }

  .freq { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem; padding: 0.25rem; border: 2px solid var(--ink-2); border-radius: 999px; background: var(--bg); margin-bottom: 1.25rem; }
  .tab, .opt, .fee-label { position: relative; display: block; cursor: pointer; }
  .tab input, .opt input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .tab span { display: flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 46px; border-radius: 999px; font-weight: 800; color: var(--ink); }
  .tab input:checked + span { background: var(--btn-bg); color: var(--btn-ink); }
  .tab input:checked + span::before { content: "\2713"; }

  .callout { margin: 0 0 1.25rem; padding: 0.8rem 1.1rem; border-left: 5px solid var(--sage); background: var(--sage-tint); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; color: var(--sage-ink); line-height: 1.5; font-weight: 600; }

  .ladder legend { font-weight: 800; color: var(--ink); margin-bottom: 0.6rem; padding: 0; }
  /* 6.5rem is the narrowest tile that fits "✓ $25" and the Suggested tag at 14px without clipping (checked 320-430px). */
  .options { display: grid; grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr)); gap: 0.65rem; }
  .opt-face {
    position: relative; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.25rem; min-height: 68px; padding: 0.5rem 0.25rem; min-width: 0;
    border: 2px solid var(--ink-2); border-radius: var(--radius-sm); background: var(--bg); color: var(--ink); text-align: center;
  }
  .opt-amt { font-family: var(--serif); font-variation-settings: "SOFT" 100; font-size: 1.35rem; font-weight: 600; line-height: 1.2; white-space: nowrap; }
  /* "/month" sits on its own line under the amount so the selected "✓ $5" never overflows a narrow tile */
  .opt-amt small { display: block; font-family: var(--sans); font-size: var(--fs-caption); font-weight: 600; line-height: 1.3; }
  /* The "Suggested" pill sits on the card's bottom edge so every option stays the same height. */
  .tag { position: absolute; left: 50%; bottom: 0; transform: translate(-50%, 50%); background: var(--bg); font-size: var(--fs-caption); font-weight: 800; line-height: 1.5; padding: 0 0.4rem; border: 1px solid currentColor; border-radius: 999px; white-space: nowrap; }
  .opt { display: block; }
  .opt input:checked + .opt-face .tag { background: var(--btn-bg); }
  .options { padding-bottom: 0.6rem; }
  .opt input:checked + .opt-face { background: var(--btn-bg); border-color: var(--btn-bg); color: var(--btn-ink); box-shadow: inset 0 0 0 2px var(--btn-ink); }
  .opt input:checked + .opt-face .opt-amt::before { content: "\2713\00a0"; }
  .tab input:focus-visible + span, .opt input:focus-visible + .opt-face, .fee-label input:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }

  .other { margin-top: 1rem; }
  .other label { display: block; font-weight: 800; color: var(--ink); margin-bottom: 0.4rem; }
  .other-row { display: flex; align-items: center; gap: 0.5rem; color: var(--ink); font-weight: 700; }
  .other-row input { width: 10rem; min-height: 48px; padding: 0.5rem 0.9rem; font-size: 1.1rem; border: 2px solid var(--ink-2); border-radius: var(--radius-sm); background: var(--bg); color: var(--ink); font-family: inherit; }
  .other-row input[aria-invalid="true"] { border-color: #b3261e; }
  .error { margin: 0.4rem 0 0; min-height: 1.4em; color: #a31d16; font-size: var(--fs-small); font-weight: 600; }
  :global(:root[data-theme="dark"]) .error { color: #ffb4a8; }

  .impact { margin: 1.25rem 0 1rem; min-height: 3em; color: var(--ink-2); line-height: 1.5; text-align: center; font-size: 1.05rem; }
  .fee { margin-bottom: 1.25rem; }
  .fee-label { display: flex; align-items: center; gap: 0.75rem; min-height: 44px; color: var(--ink); line-height: 1.4; }
  .fee-label input { flex: none; width: 24px; height: 24px; margin: 0; accent-color: var(--clay); }
  .helper { margin: 0.1rem 0 0 calc(24px + 0.75rem); font-size: 0.9rem; color: var(--ink-2); }

  .give-button {
    display: block; padding: 1rem 1.5rem; border-radius: 999px; background: var(--btn-bg); color: var(--btn-ink); text-align: center; text-decoration: none;
    font-family: var(--serif); font-variation-settings: "SOFT" 100; font-size: 1.4rem; font-weight: 600; box-shadow: 0 10px 24px -10px var(--btn-bg);
    transition: background 0.2s, transform 0.2s;
  }
  .give-button:hover { background: var(--btn-bg-hover); color: var(--btn-ink); }
  @media (prefers-reduced-motion: no-preference) { .give-button:hover { transform: translateY(-2px); } }
  .give-button[role="button"] { cursor: pointer; }
  .give-button[aria-disabled="true"] { background: #6e6258; color: #fff; box-shadow: none; transform: none; cursor: not-allowed; }
  :global(:root[data-theme="dark"]) .give-button[aria-disabled="true"] { background: #7b6a5c; color: #1b100a; }

  .give-status { margin: 0.75rem 0 0; min-height: 1.4em; text-align: center; color: var(--ink); font-weight: 600; }
  .give-status :global(a) { color: var(--ink); text-decoration: underline; }
  .secure { margin: 0.9rem 0 0; text-align: center; color: var(--ink-2); font-size: var(--fs-small); }
  .secure a, .noscript-links a, .fine-print a { color: var(--ink); text-decoration: underline; }
  .deductible { margin: 1.1rem 0 0; padding-top: 1.1rem; border-top: 1px dashed var(--line); color: var(--ink); line-height: 1.6; text-align: center; }
  .noscript-links { margin-top: 1rem; color: var(--ink-2); }
  .noscript-links ul { padding-left: 1.25rem; }
  .noscript-links li { margin-bottom: 0.5rem; }

  .why h2 { font-size: 1.7rem; margin-bottom: 0.8rem; }
  .why > p { color: var(--ink-2); margin-bottom: 1.4rem; }
  .group { margin-top: 1.6rem; }
  .group h3 { font-size: 1.2rem; margin: 0 0 0.35rem; }
  .group-intro { color: var(--ink-2); margin: 0 0 0.8rem; }
  .project-list { list-style: none; display: grid; gap: 0.75rem; }
  .project-list li { padding: 0.8rem 1.1rem; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--ink-2); }
  .project-list a, .project-name { color: var(--ink); font-weight: 800; margin-right: 0.5rem; }
  .project-list a { text-decoration: underline; text-decoration-color: var(--clay); text-underline-offset: 3px; }
  .project-list a:hover { color: var(--clay-ink); }

  .fine-print { text-align: center; color: var(--ink-2); font-size: var(--fs-small); margin-bottom: 1.6rem; }
  .blessing { text-align: center; font-family: var(--serif); font-variation-settings: "SOFT" 100; font-size: 1.35rem; color: var(--ink); }
</style>
