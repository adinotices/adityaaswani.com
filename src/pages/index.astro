---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import { identity, products, statusLabel, essays, essaysHome, meditation, support, newsletter } from '../data/site';

const fmtDate = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const latest = essays.slice(0, 6);
const featuredSlugs = ['sutam', 'savethedogs'];
const ph = identity.photo;
---
<Layout
  title="Aditya Aswani — Buddhist, writer, animal rights activist and builder"
  description="Aditya Aswani: Buddhist, writer, animal rights activist and builder. Free tools like Sutam and PausePal, essays, and one-on-one meditation guidance."
  ogImage="/aditya-960.webp"
>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-h">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Hello, I'm</p>
          <h1 id="hero-h">{identity.name}</h1>
          <p class="one-line">{identity.oneLine}</p>
          <p class="intro">{identity.intro}</p>
          <div class="cta">
            <a class="btn btn-primary" href="#building">See what I'm building</a>
            <a class="btn btn-secondary" href="#newsletter">Read my essays by email</a>
          </div>
        </div>
        <div class="portrait">
          <img
            src={ph.src(640)} srcset={`${ph.src(320)} 320w, ${ph.src(640)} 640w, ${ph.src(960)} 960w`}
            sizes="(min-width: 900px) 340px, 120px" width="640" height="960" alt={ph.alt}
            fetchpriority="high" decoding="async"
          />
        </div>
      </div>
      <div class="wrap">
        <div class="strip" role="group" aria-labelledby="strip-h">
          <h2 id="strip-h" class="mono strip-h">Now shipping</h2>
          <ul>
            {products.map((p) => (
              <li><a href={`#p-${p.slug}`}><span class="n">{p.name}</span><span class={`pill pill-${p.status}`}>{statusLabel[p.status]}</span></a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="building" class="section" aria-labelledby="building-h">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">Products</p>
          <h2 id="building-h">Things I'm building</h2>
          <p class="sec-sub">Free or at cost, built in the open. Support keeps them that way.</p>
        </div>
        <div class="bento">
          {products.map((p, i) => (
            <div class:list={['cell', { wide: featuredSlugs.includes(p.slug) }]}>
              <ProductCard product={p} featured={featuredSlugs.includes(p.slug)} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="writing" class="section" aria-labelledby="writing-h">
      <div class="wrap">
        <div class="sec-head row">
          <div>
            <p class="eyebrow">Essays</p>
            <h2 id="writing-h">Writing</h2>
          </div>
          <a class="more" href={essaysHome}>All essays<span aria-hidden="true"> →</span></a>
        </div>
        <ul class="posts">
          {latest.map((e) => (
            <li class="post">
              <img src={e.cover} width="800" height="500" alt="" loading="lazy" decoding="async" />
              <div class="pbody">
                <p class="mono date"><time datetime={e.date}>{fmtDate(e.date)}</time></p>
                <h3><a href={e.url}>{e.title}</a></h3>
                <p class="sub">{e.subtitle}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="med-h">
      <div class="wrap duo">
        <div class="panel">
          <p class="eyebrow">Meditation</p>
          <h2 id="med-h">Meditation guidance</h2>
          <p>{meditation.blurb}</p>
          <div class="cta">
            <a class="btn btn-secondary" href={meditation.href}>About meditation guidance</a>
            <a class="btn btn-primary" href={meditation.bookUrl}>Book a session</a>
          </div>
        </div>
        <div class="panel support">
          <p class="eyebrow">Support</p>
          <h2 id="sup-h">Support my work</h2>
          <p>Everything I build is free or at cost. If it has been useful to you, you can help keep it that way.</p>
          <div class="cta">
            <a class="btn btn-primary" href={support.href}>{support.label}</a>
          </div>
        </div>
      </div>
    </section>

    <section id="newsletter" class="section" aria-labelledby="nl-h">
      <div class="wrap">
        <div class="nl">
          <div>
            <p class="eyebrow">Newsletter</p>
            <h2 id="nl-h">{newsletter.name}</h2>
            <p class="nl-sub">{newsletter.tagline}</p>
          </div>
          <div>
            <form action={newsletter.formAction} method="post" target="_blank" class="form">
              <label for="nl-email">Email address</label>
              <div class="row">
                <input id="nl-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
                <button type="submit" class="btn btn-primary">Subscribe</button>
              </div>
              <p class="fine">Opens Substack in a new tab to confirm. Unsubscribe anytime.</p>
            </form>
            <p class="contact-line">Or just say hello: <a href="/contact">contact page</a> or <a href="mailto:hello@adityaaswani.com">hello@adityaaswani.com</a>.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .hero { padding: 2.5rem 0 1rem; }
  .hero-grid { display: grid; gap: 1.5rem; grid-template-columns: 1fr; position: relative; }
  .portrait { order: -1; width: 96px; }
  .portrait img { width: 96px; height: 96px; object-fit: cover; object-position: 50% 18%; border-radius: 50%; border: 2px solid var(--line-strong); background: var(--surface-2); }
  .hero-copy h1 { font-size: clamp(2.6rem, 9vw, 5.2rem); letter-spacing: -0.04em; margin: 0.9rem 0 0.9rem; font-weight: 700; }
  .eyebrow { margin: 0; }
  .one-line { font-size: clamp(1.35rem, 3.6vw, 2rem); line-height: 1.25; font-weight: 550; letter-spacing: -0.02em; max-width: 30ch; text-wrap: balance; }
  .intro { margin-top: 1.1rem; color: var(--muted); font-size: 1.08rem; max-width: 40rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.6rem; }
  @media (min-width: 900px) {
    .hero { padding: 4.5rem 0 1.5rem; }
    .hero-grid { grid-template-columns: 1.6fr 1fr; gap: 3rem; align-items: center; }
    .portrait { order: 0; width: auto; justify-self: end; }
    .portrait img { width: 340px; height: 400px; border-radius: 20px; object-position: 50% 20%; transform: rotate(1.5deg); box-shadow: var(--shadow); border-width: 1px; }
  }

  .strip { margin-top: 2.5rem; border: 1px solid var(--line); background: var(--surface); border-radius: var(--radius); padding: 0.9rem 1rem; display: grid; gap: 0.6rem; }
  .strip-h { text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 500; display: flex; align-items: center; gap: 0.5rem; }
  .strip-h::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 0 var(--ok); }
  @media (prefers-reduced-motion: no-preference) {
    .strip-h::before { animation: ping 2.4s ease-out infinite; }
    @keyframes ping { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 55%, transparent); } 80%, 100% { box-shadow: 0 0 0 8px transparent; } }
  }
  .strip ul { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .strip a { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 40px; padding: 0 0.6rem; border: 1px solid var(--line); border-radius: 10px; color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.95rem; background: var(--bg); transition: border-color 0.15s, transform 0.15s; }
  .strip .pill::before { display: none; }
  .strip a:hover { border-color: var(--accent); transform: translateY(-1px); }
  @media (min-width: 900px) { .strip { grid-template-columns: auto 1fr; align-items: center; gap: 1.2rem; } }

  .section { padding: 3.5rem 0 1rem; }
  @media (min-width: 900px) { .section { padding: 5.5rem 0 1rem; } }
  .sec-head { margin-bottom: 1.8rem; }
  .sec-head h2 { font-size: clamp(1.9rem, 4.5vw, 2.8rem); margin-top: 0.7rem; }
  .sec-sub { color: var(--muted); margin-top: 0.6rem; max-width: 36rem; }
  .sec-head.row { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; }
  .more { font-weight: 600; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .more:hover { text-decoration: underline; }

  .bento { display: grid; gap: 1.1rem; grid-template-columns: 1fr; }
  .cell { display: flex; }
  .cell > :global(*) { flex: 1; }
  @media (min-width: 600px) { .bento { grid-template-columns: repeat(2, 1fr); } .cell.wide { grid-column: 1 / -1; } }
  @media (min-width: 960px) { .bento { grid-template-columns: repeat(6, 1fr); gap: 1.25rem; } .cell { grid-column: span 2; } .cell.wide { grid-column: 1 / -1; } }

  .posts { display: grid; gap: 0.9rem; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .posts { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .posts { grid-template-columns: repeat(3, 1fr); } }
  .post { position: relative; display: grid; grid-template-columns: 120px 1fr; gap: 0.9rem; padding: 0.7rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); transition: border-color 0.2s, transform 0.2s; }
  .post:hover { border-color: var(--accent); transform: translateY(-2px); }
  .post img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 8px; background: var(--surface-2); align-self: start; }
  .pbody { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .date { color: var(--muted); }
  .post h3 { font-size: 1.02rem; line-height: 1.25; letter-spacing: -0.01em; }
  .post h3 a { color: var(--text); text-decoration: none; }
  .post h3 a::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius); }
  .post:has(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 3px; }
  .post h3 a:focus-visible { outline: none; }
  .sub { color: var(--muted); font-size: 0.9rem; }
  @media (min-width: 1000px) {
    .post { grid-template-columns: 1fr; }
    .post img { align-self: auto; }
    .post h3 { font-size: 1.1rem; }
  }

  .duo { display: grid; gap: 1.1rem; grid-template-columns: 1fr; }
  @media (min-width: 800px) { .duo { grid-template-columns: 1.2fr 1fr; } }
  .panel { padding: 1.8rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .panel h2 { font-size: clamp(1.6rem, 3.5vw, 2.1rem); margin: 0.7rem 0 0.8rem; }
  .panel p:not(.eyebrow) { color: var(--muted); }
  .panel.support { background: var(--accent-soft); border-color: transparent; }
  .panel.support p:not(.eyebrow) { color: var(--text); }
  .panel .cta { margin-top: 1.4rem; }

  .nl { display: grid; gap: 1.6rem; padding: 2rem 1.5rem; border-radius: 20px; background: var(--text); color: var(--bg); }
  .nl .eyebrow { color: color-mix(in srgb, var(--bg) 70%, transparent); }
  .nl h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); margin-top: 0.7rem; }
  .nl-sub { margin-top: 0.6rem; color: color-mix(in srgb, var(--bg) 75%, transparent); max-width: 30rem; }
  @media (min-width: 800px) { .nl { grid-template-columns: 1fr 1fr; padding: 3rem; align-items: center; gap: 3rem; } }
  .form label { display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.95rem; }
  .form .row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .form input { flex: 1 1 14rem; min-height: 46px; padding: 0 0.9rem; border-radius: 10px; border: 1.5px solid transparent; font: inherit; background: var(--bg); color: var(--text); }
  .form input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .nl :global(.btn-primary) { background: var(--accent); }
  .fine { margin-top: 0.5rem; font-size: 0.85rem; color: color-mix(in srgb, var(--bg) 72%, transparent); }
  .contact-line { margin-top: 1.1rem; color: color-mix(in srgb, var(--bg) 85%, transparent); }
  .nl a:not(.btn) { color: inherit; font-weight: 600; }
  .nl :global(:focus-visible) { outline-color: var(--accent); }
</style>
