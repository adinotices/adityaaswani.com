---
import { projects, posts, heroLinks } from "../data/previewContent";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Preview · Shounen — Aditya Aswani</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bungee+Inline&family=Black+Ops+One&family=Russo+One&family=Saira+Condensed:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@500;700;900&display=swap"
    />

    <style is:global>
      :root {
        --ink: #0a0a12;
        --ink-deep: #050508;
        --panel: #15141e;
        --panel-soft: #1f1d2c;
        --paper: #ede8dc;
        --paper-dim: #b8b3a3;
        --paper-faint: #6e6a5e;
        --crimson: #d3252e;
        --crimson-deep: #9b1a22;
        --crimson-bright: #ff3b46;
        --gold: #f5c518;
        --steel: #6f7480;
        --olive: #5a5630;
        --display: "Bungee Inline", system-ui, sans-serif;
        --tactical: "Black Ops One", system-ui, sans-serif;
        --bold: "Russo One", system-ui, sans-serif;
        --body: "Saira Condensed", system-ui, sans-serif;
        --jp: "Noto Sans JP", sans-serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      ::selection {
        background: var(--crimson);
        color: var(--paper);
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--ink);
        color: var(--paper);
        font-family: var(--body);
        font-size: 18px;
        line-height: 1.55;
        font-weight: 400;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        position: relative;
        overflow-x: hidden;
        background-image:
          radial-gradient(
            ellipse at top right,
            rgba(211, 37, 46, 0.18) 0%,
            transparent 50%
          ),
          radial-gradient(
            ellipse at 20% 80%,
            rgba(245, 197, 24, 0.05) 0%,
            transparent 45%
          ),
          linear-gradient(180deg, var(--ink) 0%, var(--ink-deep) 100%);
        background-attachment: fixed;
      }

      /* halftone screentone overlay */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        background-image: radial-gradient(
          rgba(255, 255, 255, 0.018) 1px,
          transparent 1px
        );
        background-size: 4px 4px;
        opacity: 0.6;
      }

      /* watermark kanji */
      body::after {
        content: "自由";
        position: fixed;
        right: -3vw;
        top: 18%;
        font-family: var(--jp);
        font-weight: 900;
        font-size: clamp(20rem, 38vw, 42rem);
        line-height: 0.85;
        color: var(--crimson);
        opacity: 0.05;
        pointer-events: none;
        z-index: 0;
        letter-spacing: -0.04em;
        white-space: nowrap;
      }

      main {
        max-width: 1180px;
        margin: 0 auto;
        padding: 1rem 1.5rem 4rem;
        position: relative;
        z-index: 2;
      }

      a {
        color: inherit;
      }

      /* ---------- tactical strip ---------- */
      .strip {
        background: var(--crimson);
        color: var(--paper);
        font-family: var(--tactical);
        font-size: 0.78rem;
        letter-spacing: 0.32em;
        padding: 0.45rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        text-transform: uppercase;
        margin: 0 -0.25rem 0;
        white-space: nowrap;
        overflow: hidden;
        gap: 1.5rem;
      }

      .strip-left,
      .strip-right {
        display: flex;
        gap: 1.25rem;
        flex-wrap: nowrap;
      }

      .strip span {
        position: relative;
      }

      .strip span:not(:last-child)::after {
        content: "◆";
        position: absolute;
        right: -0.95rem;
        color: var(--ink);
        font-size: 0.55rem;
        top: 50%;
        transform: translateY(-50%);
      }

      .strip-blink {
        background: var(--gold);
        color: var(--ink);
        padding: 0.05rem 0.35rem;
        font-family: var(--tactical);
        animation: pulse-bg 1.4s steps(2) infinite;
        letter-spacing: 0.1em;
      }

      @keyframes pulse-bg {
        50% {
          background: var(--ink);
          color: var(--gold);
        }
      }

      /* ---------- nav ---------- */
      .nav {
        display: flex;
        flex-wrap: wrap;
        margin: 0 -0.25rem 2.5rem;
        background: var(--panel);
        border: 2px solid var(--paper);
      }

      .nav a {
        flex: 1;
        text-align: center;
        font-family: var(--tactical);
        font-size: 0.92rem;
        letter-spacing: 0.15em;
        color: var(--paper);
        text-decoration: none;
        padding: 0.95rem 0.5rem;
        border-right: 2px solid var(--paper);
        text-transform: uppercase;
        position: relative;
        transition: background 0.15s ease, color 0.15s ease;
        white-space: nowrap;
      }

      .nav a:last-child {
        border-right: none;
      }

      .nav a::before {
        content: "▮";
        margin-right: 0.4em;
        color: var(--crimson);
        font-size: 0.7em;
      }

      .nav a:hover {
        background: var(--paper);
        color: var(--ink);
      }

      .nav a:hover::before {
        color: var(--ink);
      }

      .nav a.danger {
        background: var(--crimson);
        color: var(--paper);
      }

      .nav a.danger::before {
        content: "⚠";
        color: var(--gold);
        font-size: 1em;
        margin-right: 0.4em;
      }

      .nav a.danger:hover {
        background: var(--gold);
        color: var(--ink);
      }

      /* ---------- hero ---------- */
      .hero {
        position: relative;
        padding: 2.5rem 0 3.5rem;
      }

      /* speed lines burst */
      .hero::before {
        content: "";
        position: absolute;
        top: 50%;
        left: -10%;
        width: 70%;
        height: 1px;
        transform-origin: right center;
        background: repeating-linear-gradient(
          90deg,
          var(--crimson) 0,
          var(--crimson) 4px,
          transparent 4px,
          transparent 12px,
          var(--crimson) 12px,
          var(--crimson) 30px,
          transparent 30px,
          transparent 70px
        );
        opacity: 0.5;
        z-index: 0;
        animation: dash 1.2s ease-out 1s both;
      }

      @keyframes dash {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }

      .hero-eyebrow {
        font-family: var(--tactical);
        font-size: 0.85rem;
        letter-spacing: 0.32em;
        color: var(--crimson);
        margin-bottom: 1rem;
        text-transform: uppercase;
        position: relative;
        z-index: 2;
      }

      .hero-eyebrow::before {
        content: "▲ ";
        color: var(--gold);
        margin-right: 0.4rem;
      }

      .hero-title {
        font-family: var(--display);
        font-size: clamp(3.5rem, 13vw, 11rem);
        line-height: 0.85;
        letter-spacing: -0.005em;
        color: var(--paper);
        position: relative;
        z-index: 2;
        text-shadow:
          6px 6px 0 var(--crimson-deep);
        margin-bottom: 0.4rem;
      }

      .hero-title-2 {
        color: var(--gold);
        text-shadow:
          6px 6px 0 var(--ink-deep);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 3rem;
        margin-top: 2.5rem;
        align-items: center;
        position: relative;
        z-index: 2;
      }

      /* speech bubble — angular jagged action style */
      .speech {
        position: relative;
        background: var(--panel);
        border: 3px solid var(--paper);
        padding: 1.4rem 1.6rem;
        max-width: 540px;
        font-family: var(--body);
        font-size: 1.15rem;
        font-weight: 400;
        color: var(--paper);
        line-height: 1.55;
        clip-path: polygon(
          0 12px,
          12px 0,
          calc(100% - 12px) 0,
          100% 12px,
          100% calc(100% - 12px),
          calc(100% - 12px) 100%,
          12px 100%,
          0 calc(100% - 12px)
        );
      }

      .speech-tail {
        position: absolute;
        bottom: -22px;
        left: 50px;
        width: 0;
        height: 0;
        border-left: 18px solid transparent;
        border-right: 4px solid transparent;
        border-top: 26px solid var(--paper);
        z-index: 2;
      }

      .speech-tail::after {
        content: "";
        position: absolute;
        top: -28px;
        left: -14px;
        width: 0;
        height: 0;
        border-left: 12px solid transparent;
        border-right: 3px solid transparent;
        border-top: 18px solid var(--panel);
      }

      .speech strong {
        background: var(--crimson);
        color: var(--paper);
        padding: 0 0.3em;
        font-weight: 600;
      }

      .speech em {
        font-style: normal;
        color: var(--gold);
        font-weight: 600;
      }

      .hero-actions {
        display: flex;
        gap: 0.85rem;
        margin-top: 2.5rem;
        flex-wrap: wrap;
      }

      .btn {
        font-family: var(--tactical);
        font-size: 0.95rem;
        letter-spacing: 0.15em;
        text-decoration: none;
        padding: 1rem 1.5rem;
        border: 2px solid var(--paper);
        background: var(--ink);
        color: var(--paper);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-transform: uppercase;
        position: relative;
        transition:
          transform 0.12s ease,
          background 0.12s ease,
          color 0.12s ease;
        clip-path: polygon(
          10px 0,
          100% 0,
          100% calc(100% - 10px),
          calc(100% - 10px) 100%,
          0 100%,
          0 10px
        );
      }

      .btn:hover {
        transform: translate(-2px, -2px);
        background: var(--paper);
        color: var(--ink);
      }

      .btn-primary {
        background: var(--crimson);
        color: var(--paper);
        border-color: var(--crimson);
      }

      .btn-primary:hover {
        background: var(--gold);
        color: var(--ink);
        border-color: var(--gold);
      }

      .btn .arrow {
        font-size: 1.1em;
        transition: transform 0.15s ease;
      }

      .btn:hover .arrow {
        transform: translateX(0.25rem);
      }

      /* ---------- photo ---------- */
      .hero-photo-wrap {
        position: relative;
        justify-self: end;
        max-width: 320px;
      }

      .hero-photo {
        position: relative;
        clip-path: polygon(
          16px 0,
          100% 0,
          100% calc(100% - 16px),
          calc(100% - 16px) 100%,
          0 100%,
          0 16px
        );
        background: var(--ink);
        padding: 4px;
      }

      .hero-photo-inner {
        position: relative;
        clip-path: polygon(
          12px 0,
          100% 0,
          100% calc(100% - 12px),
          calc(100% - 12px) 100%,
          0 100%,
          0 12px
        );
        overflow: hidden;
      }

      .hero-photo img {
        display: block;
        width: 100%;
        height: auto;
        filter: grayscale(1) contrast(1.3) brightness(0.95);
      }

      .hero-photo-inner::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          180deg,
          rgba(211, 37, 46, 0.32) 0%,
          rgba(211, 37, 46, 0.08) 100%
        );
        mix-blend-mode: screen;
        pointer-events: none;
      }

      /* corner brackets */
      .hero-photo-wrap::before,
      .hero-photo-wrap::after {
        content: "";
        position: absolute;
        width: 28px;
        height: 28px;
        border: 3px solid var(--gold);
      }

      .hero-photo-wrap::before {
        top: -10px;
        left: -10px;
        border-right: none;
        border-bottom: none;
      }

      .hero-photo-wrap::after {
        bottom: -10px;
        right: -10px;
        border-left: none;
        border-top: none;
      }

      .photo-stat {
        background: var(--ink);
        color: var(--paper);
        font-family: var(--tactical);
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        padding: 0.5rem 0.85rem;
        position: absolute;
        bottom: 14px;
        left: -10px;
        border: 2px solid var(--gold);
        text-transform: uppercase;
      }

      .photo-stat .dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        background: var(--crimson-bright);
        border-radius: 50%;
        margin-right: 0.4rem;
        vertical-align: middle;
        animation: pulse 1.5s ease-in-out infinite;
      }

      @keyframes pulse {
        50% {
          opacity: 0.4;
        }
      }

      /* ---------- section header ---------- */
      .section-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 5rem 0 2rem;
        position: relative;
      }

      .section-header::after {
        content: "";
        flex: 1;
        height: 4px;
        background: repeating-linear-gradient(
          90deg,
          var(--paper) 0,
          var(--paper) 12px,
          transparent 12px,
          transparent 18px
        );
      }

      .section-num {
        font-family: var(--tactical);
        font-size: 0.92rem;
        letter-spacing: 0.18em;
        color: var(--crimson);
        text-transform: uppercase;
      }

      .section-header h2 {
        font-family: var(--display);
        font-size: clamp(2rem, 5.5vw, 3.4rem);
        color: var(--paper);
        text-shadow: 4px 4px 0 var(--crimson-deep);
        line-height: 1;
        letter-spacing: -0.005em;
      }

      .section-jp {
        font-family: var(--jp);
        font-weight: 900;
        font-size: 1rem;
        color: var(--paper-faint);
        letter-spacing: 0.1em;
        margin-left: 0.5rem;
      }

      /* ---------- mission cards ---------- */
      .missions {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.25rem;
      }

      .mission {
        display: flex;
        flex-direction: column;
        position: relative;
        background: var(--panel);
        border: 2px solid var(--paper);
        padding: 1.5rem 1.5rem 1.4rem;
        text-decoration: none;
        color: var(--paper);
        transition:
          transform 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease;
        clip-path: polygon(
          14px 0,
          100% 0,
          100% calc(100% - 14px),
          calc(100% - 14px) 100%,
          0 100%,
          0 14px
        );
        overflow: hidden;
        height: 100%;
      }

      .mission::before {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 90px;
        height: 90px;
        background-image: radial-gradient(
          rgba(211, 37, 46, 0.45) 1.5px,
          transparent 1.5px
        );
        background-size: 7px 7px;
        clip-path: polygon(40% 0, 100% 0, 100% 60%);
        pointer-events: none;
      }

      .mission:hover {
        transform: translate(-3px, -3px);
        background: var(--panel-soft);
        border-color: var(--gold);
      }

      .mission-meta {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.85rem;
      }

      .mission-num {
        font-family: var(--display);
        font-size: 1.6rem;
        color: var(--gold);
        line-height: 1;
        text-shadow: 2px 2px 0 var(--ink-deep);
      }

      .mission-status {
        font-family: var(--tactical);
        font-size: 0.62rem;
        letter-spacing: 0.18em;
        color: var(--crimson);
        background: rgba(211, 37, 46, 0.12);
        border: 1px solid var(--crimson);
        padding: 0.22rem 0.55rem;
        text-transform: uppercase;
      }

      .mission-status.open {
        color: var(--gold);
        border-color: var(--gold);
        background: rgba(245, 197, 24, 0.08);
      }

      .mission-title {
        font-family: var(--bold);
        font-size: 1.25rem;
        line-height: 1.2;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: -0.005em;
      }

      .mission-desc {
        font-family: var(--body);
        font-size: 1rem;
        color: var(--paper-dim);
        line-height: 1.5;
        margin-bottom: 1rem;
      }

      .mission-cta {
        font-family: var(--tactical);
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        color: var(--gold);
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: transform 0.15s ease;
        margin-top: auto;
        padding-top: 0.6rem;
        align-self: flex-start;
      }

      .mission:hover .mission-cta {
        transform: translateX(0.3rem);
      }

      /* ---------- field reports ---------- */
      .reports {
        list-style: none;
        display: grid;
        gap: 1rem;
      }

      .report {
        background: var(--panel);
        border: 2px solid var(--paper);
        padding: 1.25rem 1.5rem;
        text-decoration: none;
        color: var(--paper);
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 1.5rem;
        align-items: center;
        transition:
          transform 0.2s ease,
          border-color 0.2s ease,
          background 0.2s ease;
        position: relative;
      }

      .report:hover {
        background: var(--panel-soft);
        border-color: var(--gold);
        transform: translateX(0.5rem);
      }

      .report-stamp {
        font-family: var(--tactical);
        font-size: 0.6rem;
        letter-spacing: 0.18em;
        color: var(--paper);
        background: var(--crimson);
        padding: 0.35rem 0.55rem;
        text-align: center;
        line-height: 1.3;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .report-stamp.classic {
        background: var(--ink);
        color: var(--gold);
        border: 1px solid var(--gold);
      }

      .report-stamp .num {
        display: block;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
      }

      .report-info {
        min-width: 0;
      }

      .report-meta {
        font-family: var(--tactical);
        font-size: 0.62rem;
        letter-spacing: 0.18em;
        color: var(--paper-faint);
        margin-bottom: 0.35rem;
        text-transform: uppercase;
      }

      .report-title {
        font-family: var(--bold);
        font-size: 1.2rem;
        line-height: 1.25;
        margin-bottom: 0.3rem;
        text-transform: uppercase;
        letter-spacing: -0.005em;
      }

      .report-desc {
        font-family: var(--body);
        font-size: 1rem;
        color: var(--paper-dim);
      }

      .report-arrow {
        font-family: var(--tactical);
        font-size: 1.1rem;
        color: var(--crimson);
        transition: transform 0.15s ease;
      }

      .all-essays {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.75rem;
        font-family: var(--tactical);
        font-size: 0.92rem;
        letter-spacing: 0.18em;
        color: var(--paper);
        background: transparent;
        text-decoration: none;
        padding: 0.95rem 1.5rem;
        border: 2px solid var(--paper);
        text-transform: uppercase;
        clip-path: polygon(
          10px 0,
          100% 0,
          100% calc(100% - 10px),
          calc(100% - 10px) 100%,
          0 100%,
          0 10px
        );
        transition: all 0.15s ease;
      }

      .all-essays:hover {
        background: var(--paper);
        color: var(--ink);
      }

      /* ---------- enlist ---------- */
      .enlist {
        background: var(--panel);
        border: 2px solid var(--paper);
        padding: 2rem;
        position: relative;
        clip-path: polygon(
          16px 0,
          calc(100% - 16px) 0,
          100% 16px,
          100% calc(100% - 16px),
          calc(100% - 16px) 100%,
          16px 100%,
          0 calc(100% - 16px),
          0 16px
        );
      }

      .enlist::before,
      .enlist::after {
        content: "";
        position: absolute;
        background-image: radial-gradient(
          rgba(245, 197, 24, 0.5) 1.5px,
          transparent 1.5px
        );
        background-size: 7px 7px;
        pointer-events: none;
      }

      .enlist::before {
        top: 0;
        left: 0;
        width: 80px;
        height: 80px;
        clip-path: polygon(0 0, 60% 0, 0 60%);
      }

      .enlist::after {
        bottom: 0;
        right: 0;
        width: 80px;
        height: 80px;
        clip-path: polygon(100% 100%, 100% 40%, 40% 100%);
      }

      .enlist-tag {
        font-family: var(--tactical);
        font-size: 0.78rem;
        letter-spacing: 0.32em;
        color: var(--gold);
        margin-bottom: 0.6rem;
        text-transform: uppercase;
      }

      .enlist-title {
        font-family: var(--display);
        font-size: clamp(1.6rem, 4vw, 2.5rem);
        line-height: 1;
        text-shadow: 3px 3px 0 var(--crimson-deep);
        margin-bottom: 0.85rem;
        letter-spacing: -0.005em;
      }

      .enlist-blurb {
        font-family: var(--body);
        font-size: 1.1rem;
        color: var(--paper-dim);
        margin-bottom: 1.5rem;
        max-width: 500px;
        line-height: 1.55;
      }

      .substack-frame {
        background: var(--ink-deep);
        padding: 0.75rem;
        border: 1px solid var(--paper-faint);
      }

      /* ---------- footer ---------- */
      .colophon {
        margin-top: 5rem;
        padding-top: 2rem;
        border-top: 4px solid var(--paper);
        position: relative;
      }

      .colophon::before {
        content: "";
        position: absolute;
        top: -4px;
        left: 0;
        height: 4px;
        width: 30%;
        background: var(--crimson);
      }

      .colophon-blessing {
        font-family: var(--display);
        font-size: clamp(1.3rem, 3vw, 1.8rem);
        line-height: 1.2;
        margin-bottom: 0.6rem;
        text-shadow: 3px 3px 0 var(--crimson-deep);
      }

      .colophon-jp {
        font-family: var(--jp);
        font-weight: 900;
        font-size: 0.95rem;
        letter-spacing: 0.18em;
        color: var(--gold);
        margin-bottom: 1.75rem;
      }

      .colophon-row {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }

      .colophon-label {
        font-family: var(--tactical);
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        color: var(--crimson);
        text-transform: uppercase;
      }

      .colophon-links {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .colophon-links a {
        font-family: var(--tactical);
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        color: var(--paper);
        text-decoration: none;
        padding: 0.45rem 0.7rem;
        border: 1px solid var(--paper);
        text-transform: uppercase;
        transition: all 0.15s ease;
      }

      .colophon-links a:hover {
        background: var(--paper);
        color: var(--ink);
      }

      .colophon-links a.back {
        background: var(--crimson);
        border-color: var(--crimson);
      }

      .colophon-links a.back:hover {
        background: var(--gold);
        border-color: var(--gold);
        color: var(--ink);
      }

      .colophon-note {
        font-family: var(--body);
        font-size: 0.92rem;
        color: var(--paper-faint);
      }

      .colophon-note .red {
        color: var(--crimson);
      }

      /* ---------- entrance ---------- */
      @keyframes slam {
        0% {
          opacity: 0;
          transform: translateY(20px) scale(0.95);
        }
        60% {
          transform: translateY(-2px) scale(1.01);
        }
        100% {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes shake {
        0% {
          opacity: 0;
          transform: translateX(-12px) skewX(-3deg);
        }
        100% {
          opacity: 1;
          transform: translateX(0) skewX(0);
        }
      }

      .strip,
      .nav,
      .hero-eyebrow,
      .hero-title,
      .speech,
      .hero-actions,
      .hero-photo-wrap {
        animation: slam 0.55s cubic-bezier(0.4, 1.4, 0.4, 1) both;
      }

      .strip {
        animation-delay: 0s;
      }
      .nav {
        animation-delay: 0.08s;
      }
      .hero-eyebrow {
        animation-delay: 0.2s;
      }
      .hero-title {
        animation: slam 0.6s cubic-bezier(0.4, 1.6, 0.4, 1) 0.3s both;
      }
      .speech {
        animation: shake 0.4s ease 0.7s both;
      }
      .hero-actions {
        animation-delay: 0.95s;
      }
      .hero-photo-wrap {
        animation-delay: 0.5s;
      }

      /* ---------- mobile ---------- */
      @media (max-width: 800px) {
        .strip {
          font-size: 0.62rem;
          letter-spacing: 0.16em;
          padding: 0.45rem 0.85rem;
          gap: 0.85rem;
        }

        .strip-left,
        .strip-right {
          gap: 0.85rem;
        }

        .strip-meta-extra {
          display: none;
        }

        .nav {
          flex-wrap: wrap;
        }

        .nav a {
          flex: 1 1 50%;
          font-size: 0.78rem;
          padding: 0.85rem 0.4rem;
          letter-spacing: 0.12em;
          border-bottom: 2px solid var(--paper);
        }

        .nav a:nth-child(2) {
          border-right: none;
        }

        .nav a:nth-child(3),
        .nav a:nth-child(4) {
          border-bottom: none;
        }

        .hero-grid {
          grid-template-columns: 1fr;
          gap: 2.5rem;
        }

        .hero-photo-wrap {
          justify-self: center;
          max-width: 240px;
        }

        .speech-tail {
          left: 30px;
        }

        .missions {
          grid-template-columns: 1fr;
        }

        .report {
          grid-template-columns: 1fr;
          gap: 0.6rem;
        }

        .report-arrow {
          display: none;
        }

        .report-stamp {
          justify-self: start;
          max-width: max-content;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-delay: 0s !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="strip">
        <div class="strip-left">
          <span>CASE FILE 2024CF1118</span>
          <span class="strip-meta-extra">VOL.04</span>
          <span class="strip-meta-extra">SPRING '26</span>
        </div>
        <div class="strip-right">
          <span class="strip-blink">⚠ ACTIVE</span>
          <span class="strip-meta-extra">BROOKLYN, NY</span>
        </div>
      </div>

      <nav class="nav">
        <a href="#work">MISSIONS</a>
        <a href="#writing">DISPATCHES</a>
        <a href="/contact/">COMMS</a>
        <a class="danger" href={heroLinks.petition} target="_blank" rel="noopener noreferrer">PETITION</a>
      </nav>

      <section class="hero">
        <p class="hero-eyebrow">DOSSIER · SUBJECT 001</p>
        <h1 class="hero-title">
          ADITYA<br />
          <span class="hero-title-2">ASWANI</span>
        </h1>

        <div class="hero-grid">
          <div>
            <div class="speech">
              <span class="speech-tail"></span>
              Writer, Buddhist meditator, and animal-rights
              <strong>defendant</strong>. Currently facing a
              <em>felony charge</em> for liberating dogs from a research lab in
              Wisconsin.
            </div>

            <div class="hero-actions">
              <a class="btn btn-primary" href={heroLinks.essay} target="_blank" rel="noopener noreferrer">
                READ DISPATCH <span class="arrow">▶</span>
              </a>
              <a class="btn" href={heroLinks.petition} target="_blank" rel="noopener noreferrer">
                JOIN PETITION <span class="arrow">▶</span>
              </a>
            </div>
          </div>

          <div class="hero-photo-wrap">
            <div class="hero-photo">
              <div class="hero-photo-inner">
                <img src="/aditya-640.webp" alt="Aditya Aswani" />
              </div>
            </div>
            <div class="photo-stat">
              <span class="dot"></span>STATUS · ENGAGED
            </div>
          </div>
        </div>
      </section>

      <header class="section-header">
        <span class="section-num">▶ 01</span>
        <h2>MISSIONS</h2>
        <span class="section-jp">任務</span>
      </header>

      <ol class="missions" id="work">
        {
          projects.map((project, i) => (
            <li>
              <a
                class="mission"
                href={project.link}
                target={project.link.startsWith("http") ? "_blank" : null}
                rel={
                  project.link.startsWith("http")
                    ? "noopener noreferrer"
                    : null
                }
              >
                <div class="mission-meta">
                  <span class="mission-num">#{project.number}</span>
                  <span class={`mission-status ${i === 0 ? "" : "open"}`}>
                    {i === 0 ? "● ACTIVE" : "● ONGOING"}
                  </span>
                </div>
                <h3 class="mission-title">{project.title}</h3>
                <p class="mission-desc">{project.description}</p>
                <span class="mission-cta">
                  ENGAGE <span>▶</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>

      <header class="section-header">
        <span class="section-num">▶ 02</span>
        <h2>DISPATCHES</h2>
        <span class="section-jp">通信</span>
      </header>

      <ol class="reports" id="writing">
        {
          posts.map((post, i) => (
            <li>
              <a
                class="report"
                href={post.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class={`report-stamp ${i === 0 ? "" : "classic"}`}>
                  {i === 0 ? "★ NEW" : <>EP.<span class="num">{String(i + 1).padStart(2, "0")}</span></>}
                </span>
                <div class="report-info">
                  <p class="report-meta">FILED · {post.date}</p>
                  <h3 class="report-title">{post.title}</h3>
                  <p class="report-desc">{post.description}</p>
                </div>
                <span class="report-arrow">▶</span>
              </a>
            </li>
          ))
        }
      </ol>

      <a class="all-essays" href={heroLinks.substack} target="_blank" rel="noopener noreferrer"
        >ALL DISPATCHES <span>▶</span></a
      >

      <header class="section-header">
        <span class="section-num">▶ 03</span>
        <h2>ENLIST</h2>
        <span class="section-jp">入隊</span>
      </header>

      <div class="enlist" id="subscribe">
        <p class="enlist-tag">▲ OFFICIAL DISPATCH</p>
        <h3 class="enlist-title">JOIN THE FRONT</h3>
        <p class="enlist-blurb">
          Get every essay, court update, and call to action straight to your
          inbox. No spam — just dispatches when there&rsquo;s something to say.
        </p>
        <div class="substack-frame">
          <iframe
            src={heroLinks.substackEmbed}
            title="Subscribe to Aditya Aswani's Substack"
            width="100%"
            height="150"
            style="border: none; background: transparent; display: block; overflow: hidden;"></iframe>
        </div>
      </div>

      <footer class="colophon">
        <p class="colophon-blessing">MAY ALL BEINGS BE FREE.</p>
        <p class="colophon-jp">願諸衆生 · 自由 · 安穏</p>

        <div class="colophon-row">
          <span class="colophon-label">▲ ELSEWHERE</span>
          <div class="colophon-links">
            <a href="/previews/" class="back">← ALL PREVIEWS</a>
            <a href="https://substack.com/@adinotices" target="_blank" rel="noopener noreferrer">SUBSTACK</a>
            <a href="https://www.instagram.com/adinotices" target="_blank" rel="noopener noreferrer">IG</a>
            <a href="https://x.com/adinotices" target="_blank" rel="noopener noreferrer">X</a>
            <a href="https://bsky.app/profile/adinotices.com" target="_blank" rel="noopener noreferrer">BLUESKY</a>
            <a href="/links/">ALL LINKS</a>
          </div>
        </div>

        <p class="colophon-note">
          Set in <span class="red">BUNGEE INLINE</span> + BLACK OPS ONE +
          SAIRA · Built with <span class="red">ASTRO</span> &amp; CLAUDE CODE
          · © 2026
        </p>
      </footer>
    </main>
  </body>
</html>
