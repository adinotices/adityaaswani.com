---
import { projects, posts, heroLinks } from "../data/previewContent";

const sectionMarks = ["一", "二", "三"];
const projectMarks = ["一", "二", "三", "四", "五"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Preview · Mincho — Aditya Aswani</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400;1,500&display=swap"
    />

    <style is:global>
      :root {
        --washi: #f7f4ed;
        --washi-warm: #ede7d8;
        --sumi: #1a1715;
        --sumi-soft: #6a6358;
        --sumi-faint: #b0a89b;
        --hair: #d8d2c4;
        --hanko: #a8281e;
        --serif: "Shippori Mincho", "Cormorant Garamond", ui-serif, Georgia, serif;
        --en-serif: "Cormorant Garamond", "Shippori Mincho", ui-serif, Georgia, serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      ::selection {
        background: var(--sumi);
        color: var(--washi);
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--washi);
        color: var(--sumi);
        font-family: var(--en-serif);
        font-size: 18px;
        line-height: 1.85;
        -webkit-font-smoothing: antialiased;
        font-feature-settings: "kern", "onum", "liga";
        background-image:
          radial-gradient(
            ellipse at 90% 5%,
            rgba(168, 40, 30, 0.025) 0%,
            transparent 25%
          );
        min-height: 100vh;
      }

      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 4rem 2.5rem 5rem;
        position: relative;
      }

      a {
        color: inherit;
      }

      /* ---------- top mark ---------- */
      .top-mark {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 2rem;
        align-items: center;
        font-family: var(--serif);
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        color: var(--sumi-soft);
        margin-bottom: 5rem;
        font-variant-numeric: tabular-nums;
      }

      .top-mark::before,
      .top-mark::after {
        content: "";
        height: 1px;
        background: var(--hair);
      }

      .top-mark span {
        white-space: nowrap;
      }

      .top-mark .kanji {
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.3em;
        margin: 0 0.4em;
      }

      /* ---------- hero ---------- */
      .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5rem;
        margin-bottom: 8rem;
        align-items: start;
      }

      .hero-name {
        position: relative;
      }

      .hero-name-en {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(2.4rem, 5.5vw, 4rem);
        line-height: 1.1;
        letter-spacing: -0.005em;
        color: var(--sumi);
        margin-bottom: 0.4rem;
      }

      .hero-name-en .first {
        display: block;
      }

      .hero-name-en .last {
        display: block;
        font-style: italic;
        font-family: var(--en-serif);
        font-weight: 300;
        margin-left: 1.5em;
        color: var(--sumi-soft);
        font-size: 0.85em;
      }

      .hero-name-jp {
        font-family: var(--serif);
        font-weight: 400;
        font-size: 1rem;
        letter-spacing: 0.3em;
        color: var(--sumi-faint);
        margin-top: 1.25rem;
      }

      .hanko {
        margin-top: 2rem;
        display: inline-block;
        font-family: var(--serif);
        font-weight: 600;
        font-size: 1rem;
        color: var(--hanko);
        background: transparent;
        border: 1.5px solid var(--hanko);
        padding: 0.75rem 0.6rem 0.5rem;
        line-height: 1.05;
        text-align: center;
        letter-spacing: 0.05em;
        transform: rotate(-3deg);
        position: relative;
      }

      .hanko::before {
        content: "";
        position: absolute;
        inset: 3px;
        border: 0.5px solid rgba(168, 40, 30, 0.4);
        pointer-events: none;
      }

      .hanko-row {
        display: block;
      }

      .hero-right {
        padding-top: 1rem;
      }

      .hero-photo {
        margin: 0;
        max-width: 280px;
      }

      .hero-photo img {
        display: block;
        width: 100%;
        height: auto;
        filter: grayscale(0.5) contrast(1.02) brightness(0.99);
      }

      .hero-photo figcaption {
        font-family: var(--serif);
        font-size: 0.78rem;
        color: var(--sumi-faint);
        margin-top: 0.85rem;
        letter-spacing: 0.1em;
      }

      .hero-statement {
        margin-top: 5rem;
        max-width: 520px;
      }

      .hero-statement p {
        font-family: var(--en-serif);
        font-style: italic;
        font-weight: 300;
        font-size: 1.6rem;
        line-height: 1.55;
        color: var(--sumi);
      }

      .hero-statement p + p {
        margin-top: 1.25rem;
        font-style: normal;
        font-size: 1.05rem;
        color: var(--sumi-soft);
        line-height: 1.85;
      }

      .hero-actions {
        margin-top: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }

      .ji-link {
        font-family: var(--serif);
        font-weight: 400;
        font-size: 1rem;
        color: var(--sumi);
        text-decoration: none;
        display: inline-flex;
        align-items: baseline;
        gap: 1.2rem;
        padding: 0.4rem 0;
        transition: color 0.4s ease;
        letter-spacing: 0.02em;
        width: fit-content;
      }

      .ji-link::before {
        content: "";
        width: 2.2rem;
        height: 1px;
        background: var(--sumi);
        transform: translateY(-0.35em);
        transition: width 0.4s ease;
      }

      .ji-link:hover {
        color: var(--hanko);
      }

      .ji-link:hover::before {
        width: 3.2rem;
        background: var(--hanko);
      }

      .ji-link.primary {
        color: var(--hanko);
      }

      .ji-link.primary::before {
        background: var(--hanko);
      }

      /* ---------- vertical thread ---------- */
      .thread {
        position: relative;
      }

      .thread::before {
        content: "";
        position: absolute;
        left: -2.5rem;
        top: 0.5em;
        bottom: 0.5em;
        width: 1px;
        background: var(--hair);
      }

      /* ---------- sections ---------- */
      .section {
        margin-bottom: 7rem;
      }

      .section-head {
        display: grid;
        grid-template-columns: 4rem 1fr;
        align-items: baseline;
        gap: 2rem;
        margin-bottom: 4rem;
      }

      .section-mark {
        font-family: var(--serif);
        font-size: 1.6rem;
        font-weight: 400;
        color: var(--hanko);
        text-align: center;
        line-height: 1;
      }

      .section-mark small {
        display: block;
        font-family: var(--en-serif);
        font-style: italic;
        font-size: 0.7rem;
        color: var(--sumi-faint);
        margin-top: 0.5rem;
        letter-spacing: 0.15em;
      }

      .section-head h2 {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(1.6rem, 3vw, 2rem);
        letter-spacing: -0.01em;
        line-height: 1.2;
      }

      .section-head h2 small {
        display: block;
        font-family: var(--en-serif);
        font-style: italic;
        font-size: 1rem;
        font-weight: 300;
        color: var(--sumi-soft);
        margin-top: 0.4rem;
        letter-spacing: 0.05em;
      }

      /* ---------- entries ---------- */
      .entries,
      .posts {
        list-style: none;
      }

      .entry,
      .post {
        padding: 2.25rem 0;
        border-bottom: 1px solid var(--hair);
      }

      .entry:first-child,
      .post:first-child {
        border-top: 1px solid var(--hair);
      }

      .entry-link,
      .post-link {
        display: grid;
        grid-template-columns: 4rem 1fr auto;
        gap: 2rem;
        text-decoration: none;
        color: var(--sumi);
        align-items: baseline;
        transition: padding-left 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
      }

      .entry-link:hover,
      .post-link:hover {
        padding-left: 0.5rem;
      }

      .entry-mark {
        font-family: var(--serif);
        font-size: 1.5rem;
        color: var(--sumi-faint);
        text-align: center;
        line-height: 1;
        font-weight: 400;
      }

      .entry-title {
        display: block;
        font-family: var(--serif);
        font-size: clamp(1.2rem, 2.4vw, 1.45rem);
        font-weight: 400;
        line-height: 1.35;
        letter-spacing: -0.005em;
        transition: color 0.4s ease;
      }

      .entry-link:hover .entry-title,
      .post-link:hover .post-title {
        color: var(--hanko);
      }

      .entry-description {
        display: block;
        font-family: var(--en-serif);
        font-style: italic;
        font-weight: 300;
        font-size: 1rem;
        color: var(--sumi-soft);
        margin-top: 0.6rem;
        line-height: 1.7;
        max-width: 36rem;
      }

      .entry-arrow,
      .post-arrow {
        font-family: var(--serif);
        font-size: 1.1rem;
        color: var(--sumi-faint);
        transition:
          transform 0.4s ease,
          color 0.4s ease;
        align-self: center;
      }

      .entry-link:hover .entry-arrow,
      .post-link:hover .post-arrow {
        transform: translateX(0.5rem);
        color: var(--hanko);
      }

      /* ---------- posts ---------- */
      .post-link {
        grid-template-columns: 4rem 1fr auto;
      }

      .post-date {
        font-family: var(--serif);
        font-size: 0.78rem;
        color: var(--sumi-faint);
        text-align: right;
        line-height: 1.4;
        font-variant-numeric: oldstyle-nums;
        letter-spacing: 0.04em;
        align-self: start;
        padding-top: 0.4em;
      }

      .post-title {
        display: block;
        font-family: var(--serif);
        font-size: clamp(1.1rem, 2vw, 1.3rem);
        font-weight: 400;
        line-height: 1.4;
        transition: color 0.4s ease;
      }

      .post-description {
        display: block;
        font-family: var(--en-serif);
        font-style: italic;
        font-weight: 300;
        font-size: 0.95rem;
        color: var(--sumi-soft);
        margin-top: 0.45rem;
      }

      .all-essays {
        display: inline-flex;
        align-items: baseline;
        gap: 1rem;
        margin-top: 2.25rem;
        font-family: var(--serif);
        font-size: 1rem;
        color: var(--sumi);
        text-decoration: none;
        padding: 0.4rem 0;
        transition: color 0.4s ease;
      }

      .all-essays::before {
        content: "";
        width: 2.2rem;
        height: 1px;
        background: var(--sumi);
        transform: translateY(-0.35em);
        transition:
          width 0.4s ease,
          background 0.4s ease;
      }

      .all-essays:hover {
        color: var(--hanko);
      }

      .all-essays:hover::before {
        width: 3.2rem;
        background: var(--hanko);
      }

      /* ---------- subscribe ---------- */
      .subscribe-blurb {
        font-family: var(--en-serif);
        font-style: italic;
        font-weight: 300;
        font-size: 1.25rem;
        color: var(--sumi-soft);
        margin-bottom: 2rem;
        max-width: 480px;
        line-height: 1.6;
      }

      .substack-frame {
        background: var(--washi-warm);
        padding: 1rem;
        max-width: 520px;
      }

      /* ---------- footer ---------- */
      .colophon {
        margin-top: 8rem;
        border-top: 1px solid var(--hair);
        padding-top: 2.5rem;
      }

      .colophon-blessing {
        font-family: var(--serif);
        font-size: 1.25rem;
        font-weight: 400;
        color: var(--sumi);
        margin-bottom: 0.6rem;
        letter-spacing: 0.02em;
      }

      .colophon-blessing-en {
        font-family: var(--en-serif);
        font-style: italic;
        font-weight: 300;
        font-size: 1.05rem;
        color: var(--sumi-soft);
        margin-bottom: 2.5rem;
      }

      .colophon-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }

      .colophon-label {
        font-family: var(--serif);
        font-size: 0.78rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--sumi-faint);
        margin-bottom: 0.5rem;
      }

      .colophon-links {
        display: flex;
        gap: 1.4rem;
        flex-wrap: wrap;
        font-family: var(--en-serif);
        font-size: 0.95rem;
      }

      .colophon-links a {
        color: var(--sumi);
        text-decoration: none;
        border-bottom: 1px solid var(--hair);
        padding-bottom: 0.1rem;
        transition: border-color 0.3s ease;
      }

      .colophon-links a:hover {
        border-bottom-color: var(--hanko);
      }

      .colophon-links a.back {
        color: var(--hanko);
        border-bottom-color: var(--hanko);
      }

      .colophon-note {
        font-family: var(--en-serif);
        font-style: italic;
        font-size: 0.82rem;
        color: var(--sumi-faint);
        margin-top: 2rem;
      }

      .colophon-note .dot {
        margin: 0 0.4rem;
        opacity: 0.5;
      }

      /* ---------- entrance ---------- */
      @keyframes ink {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes hanko-fall {
        0% {
          opacity: 0;
          transform: rotate(-3deg) translateY(-12px) scale(1.2);
        }
        70% {
          opacity: 1;
          transform: rotate(-3deg) translateY(2px) scale(0.96);
        }
        100% {
          opacity: 1;
          transform: rotate(-3deg) translateY(0) scale(1);
        }
      }

      .top-mark,
      .hero-name,
      .hero-photo,
      .hero-statement,
      .hero-actions,
      .hanko {
        animation: ink 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      }

      .hero-name {
        animation-delay: 0.1s;
      }
      .hero-photo {
        animation-delay: 0.4s;
      }
      .hero-statement {
        animation-delay: 0.6s;
      }
      .hero-actions {
        animation-delay: 0.85s;
      }
      .hanko {
        animation: hanko-fall 0.6s ease 1.4s both;
      }

      /* ---------- mobile ---------- */
      @media (max-width: 760px) {
        main {
          padding: 2.5rem 1.5rem 4rem;
        }

        .top-mark {
          margin-bottom: 3rem;
          font-size: 0.7rem;
          gap: 1rem;
        }

        .hero {
          grid-template-columns: 1fr;
          gap: 3rem;
          margin-bottom: 5rem;
        }

        .hero-photo {
          max-width: 200px;
        }

        .hero-statement {
          margin-top: 0;
        }

        .hero-statement p {
          font-size: 1.3rem;
        }

        .section {
          margin-bottom: 4.5rem;
        }

        .section-head {
          grid-template-columns: 3rem 1fr;
          gap: 1.25rem;
        }

        .entry-link,
        .post-link {
          grid-template-columns: 2.5rem 1fr;
        }

        .entry-arrow,
        .post-arrow {
          display: none;
        }

        .post-date {
          grid-row: 1;
          grid-column: 2;
          text-align: left;
          padding-top: 0;
        }

        .post-link {
          grid-template-columns: 2.5rem 1fr;
          gap: 1rem 1.25rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-delay: 0s !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header class="top-mark">
        <span>Spring 2026 <span class="kanji">春</span></span>
        <span class="kanji">縁</span>
        <span style="text-align: right;"
          ><span class="kanji">第</span>四<span class="kanji">号</span></span
        >
      </header>

      <section class="hero">
        <div class="hero-name">
          <h1 class="hero-name-en">
            <span class="first">Aditya</span>
            <span class="last">Aswani.</span>
          </h1>
          <p class="hero-name-jp">アディティヤ・アスワニ</p>
          <div class="hanko">
            <span class="hanko-row">阿</span>
            <span class="hanko-row">迪</span>
          </div>
        </div>

        <div class="hero-right">
          <figure class="hero-photo">
            <img src="/aditya-640.webp" alt="Aditya Aswani" />
            <figcaption>Brooklyn — 2025</figcaption>
          </figure>
        </div>
      </section>

      <section class="hero-statement">
        <p>
          Writer, Buddhist meditator, and animal-rights defendant — currently
          facing a felony charge for rescuing dogs from a research lab.
        </p>
        <p>
          This site holds the things I am working on: the case I am defending
          in court, the meditation communities I help run, and the essays I
          publish about the slow collisions between practice and the world.
        </p>
        <div class="hero-actions">
          <a class="ji-link primary" href={heroLinks.essay} target="_blank" rel="noopener noreferrer">
            Read the latest essay
          </a>
          <a class="ji-link" href={heroLinks.petition} target="_blank" rel="noopener noreferrer">
            Sign the petition for the Ridglan dogs
          </a>
        </div>
      </section>

      <hr style="border: none; height: 4rem;" />

      <section class="section" id="work">
        <header class="section-head">
          <span class="section-mark">{sectionMarks[0]}<small>i.</small></span>
          <h2>
            Work
            <small>What I am doing now</small>
          </h2>
        </header>

        <ol class="entries">
          {
            projects.map((project, i) => (
              <li class="entry">
                <a
                  class="entry-link"
                  href={project.link}
                  target={project.link.startsWith("http") ? "_blank" : null}
                  rel={
                    project.link.startsWith("http")
                      ? "noopener noreferrer"
                      : null
                  }
                >
                  <span class="entry-mark">{projectMarks[i]}</span>
                  <span>
                    <span class="entry-title">{project.title}</span>
                    <span class="entry-description">{project.description}</span>
                  </span>
                  <span class="entry-arrow">→</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="section" id="writing">
        <header class="section-head">
          <span class="section-mark">{sectionMarks[1]}<small>ii.</small></span>
          <h2>
            Writing
            <small>Recent essays</small>
          </h2>
        </header>

        <ol class="posts">
          {
            posts.map((post) => (
              <li class="post">
                <a
                  class="post-link"
                  href={post.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="post-date">{post.date}</span>
                  <span>
                    <span class="post-title">{post.title}</span>
                    <span class="post-description">{post.description}</span>
                  </span>
                  <span class="post-arrow">→</span>
                </a>
              </li>
            ))
          }
        </ol>

        <a class="all-essays" href={heroLinks.substack} target="_blank" rel="noopener noreferrer">
          Browse all essays
        </a>
      </section>

      <section class="section" id="subscribe">
        <header class="section-head">
          <span class="section-mark">{sectionMarks[2]}<small>iii.</small></span>
          <h2>
            Stay in touch
            <small>A short note when I publish</small>
          </h2>
        </header>

        <p class="subscribe-blurb">
          A short note arrives in your inbox whenever I publish. No spam — and
          you can leave any time.
        </p>

        <div class="substack-frame">
          <iframe
            src={heroLinks.substackEmbed}
            title="Subscribe to Aditya Aswani's Substack"
            width="100%"
            height="150"
            style="border: none; background: transparent; display: block; overflow: hidden;"></iframe>
        </div>
      </section>

      <footer class="colophon">
        <p class="colophon-blessing">願諸衆生・幸福・健康・安全</p>
        <p class="colophon-blessing-en">
          May all beings be happy, healthy, and safe.
        </p>

        <div class="colophon-row">
          <span class="colophon-label">Elsewhere</span>
          <div class="colophon-links">
            <a href="/previews/" class="back">← all previews</a>
            <a href="https://substack.com/@adinotices" target="_blank" rel="noopener noreferrer">Substack</a>
            <a href="https://www.instagram.com/adinotices" target="_blank" rel="noopener noreferrer">Instagram</a>
            <a href="https://x.com/adinotices" target="_blank" rel="noopener noreferrer">X</a>
            <a href="https://bsky.app/profile/adinotices.com" target="_blank" rel="noopener noreferrer">Bluesky</a>
            <a href="/links/">all links</a>
          </div>
        </div>

        <p class="colophon-note">
          Set in <em>Shippori Mincho</em> &amp; <em>Cormorant Garamond</em
          ><span class="dot">·</span>Built with <em>Astro</em> &amp;
          <em>Claude Code</em><span class="dot">·</span>© 2026
        </p>
      </footer>
    </main>
  </body>
</html>
