---
import { projects, posts, heroLinks } from "../data/previewContent";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Preview · 16-Bit — Aditya Aswani</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Pixelify+Sans:wght@400;500;600;700&display=swap"
    />

    <style is:global>
      :root {
        --bg: #14122a;
        --bg-deep: #0a0820;
        --box: #2c2a52;
        --box-light: #3d3b6e;
        --frame: #f8f8ff;
        --frame-dim: #c5c5e6;
        --text: #f8f8ff;
        --text-dim: #b9b9d8;
        --gold: #ffc83d;
        --pink: #ff5c9c;
        --cyan: #5cd9e6;
        --green: #6ad96a;
        --red: #ff5c5c;
        --pixel-h: "Press Start 2P", monospace;
        --pixel-b: "VT323", "Pixelify Sans", monospace;
        --pixel-m: "Pixelify Sans", monospace;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        image-rendering: pixelated;
      }

      ::selection {
        background: var(--gold);
        color: var(--bg);
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--pixel-b);
        font-size: 22px;
        line-height: 1.4;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
        background-image:
          radial-gradient(
            ellipse at top,
            rgba(255, 92, 156, 0.08) 0%,
            transparent 55%
          ),
          radial-gradient(
            ellipse at bottom,
            rgba(92, 217, 230, 0.06) 0%,
            transparent 55%
          ),
          linear-gradient(180deg, var(--bg) 0%, var(--bg-deep) 100%);
        background-attachment: fixed;
      }

      /* CRT scanlines */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 9999;
        background: repeating-linear-gradient(
          0deg,
          rgba(0, 0, 0, 0) 0px,
          rgba(0, 0, 0, 0) 2px,
          rgba(0, 0, 0, 0.16) 3px,
          rgba(0, 0, 0, 0.16) 4px
        );
        mix-blend-mode: multiply;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 9998;
        background: radial-gradient(
          ellipse at center,
          transparent 60%,
          rgba(0, 0, 0, 0.45) 100%
        );
      }

      main {
        max-width: 980px;
        margin: 0 auto;
        padding: 1.25rem 1.25rem 4rem;
        position: relative;
      }

      a {
        color: inherit;
      }

      /* ---------- title screen ---------- */
      .title-screen {
        text-align: center;
        padding: 2.5rem 1rem 1rem;
        margin-bottom: 1.5rem;
      }

      .title-screen-jumbo {
        font-family: var(--pixel-h);
        font-size: clamp(1.5rem, 4.5vw, 3rem);
        line-height: 1.4;
        color: var(--gold);
        text-shadow:
          3px 3px 0 var(--pink),
          6px 6px 0 var(--bg-deep);
        letter-spacing: 0;
        margin-bottom: 0.75rem;
      }

      .title-screen-sub {
        font-family: var(--pixel-h);
        font-size: 0.6rem;
        color: var(--cyan);
        letter-spacing: 0.1em;
      }

      .blink {
        animation: blink 1s steps(2) infinite;
      }

      @keyframes blink {
        50% {
          opacity: 0;
        }
      }

      .press-start {
        font-family: var(--pixel-h);
        font-size: 0.7rem;
        color: var(--frame);
        text-align: center;
        margin: 1rem 0 2rem;
      }

      /* ---------- pixel box ---------- */
      .pixel-box {
        background: var(--box);
        border: 4px solid var(--frame);
        padding: 1.5rem 1.5rem 1.4rem;
        position: relative;
        box-shadow:
          0 0 0 4px var(--bg),
          0 0 0 8px var(--frame),
          0 8px 0 0 rgba(0, 0, 0, 0.4);
        margin: 1rem 0.5rem;
      }

      /* corner pixel decoration */
      .pixel-box::before,
      .pixel-box::after {
        content: "";
        position: absolute;
        width: 12px;
        height: 12px;
        background: var(--frame);
      }

      .pixel-box::before {
        top: -4px;
        left: -4px;
        box-shadow:
          calc(100% + 8px) 0 0 0 var(--frame),
          0 calc(100% + 8px) 0 0 var(--frame),
          calc(100% + 8px) calc(100% + 8px) 0 0 var(--frame);
        display: none;
      }

      /* ---------- character panel ---------- */
      .character {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1.5rem;
        align-items: start;
      }

      .portrait-frame {
        width: 144px;
        height: 144px;
        flex-shrink: 0;
        background: var(--bg-deep);
        border: 3px solid var(--frame);
        position: relative;
        overflow: hidden;
        box-shadow: inset 0 0 0 2px var(--bg);
      }

      .portrait-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: contrast(1.25) saturate(1.45) brightness(0.95) hue-rotate(-8deg);
        image-rendering: pixelated;
      }

      .portrait-frame::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
          radial-gradient(rgba(20, 18, 42, 0.6) 30%, transparent 30%);
        background-size: 4px 4px;
        mix-blend-mode: multiply;
        opacity: 0.6;
        pointer-events: none;
      }

      .character-info {
        font-family: var(--pixel-b);
        font-size: 1.1rem;
        line-height: 1.45;
      }

      .character-name {
        font-family: var(--pixel-h);
        font-size: 1rem;
        color: var(--gold);
        margin-bottom: 1rem;
        line-height: 1.3;
      }

      .stat-row {
        display: grid;
        grid-template-columns: 5rem 1fr;
        gap: 0.6rem;
        align-items: baseline;
        margin: 0.2rem 0;
        font-family: var(--pixel-b);
        font-size: 1.2rem;
      }

      .stat-row .label {
        color: var(--cyan);
        font-family: var(--pixel-h);
        font-size: 0.55rem;
        letter-spacing: 0.05em;
      }

      .stat-row .value {
        color: var(--text);
      }

      .stat-row .red {
        color: var(--red);
      }

      .stat-row .green {
        color: var(--green);
      }

      .hp-bar {
        height: 12px;
        background: var(--bg-deep);
        border: 2px solid var(--frame);
        display: inline-block;
        width: 140px;
        position: relative;
        margin-left: 0.4rem;
        vertical-align: middle;
      }

      .hp-fill {
        height: 100%;
        background: var(--green);
        width: 0%;
        animation: fill-hp 1.6s cubic-bezier(0.4, 0, 0.2, 1) 0.6s both;
        box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.25);
      }

      @keyframes fill-hp {
        from {
          width: 0%;
        }
        to {
          width: 100%;
        }
      }

      /* ---------- dialog ---------- */
      .dialog {
        margin-top: 1.5rem;
        font-family: var(--pixel-b);
        font-size: 1.3rem;
        line-height: 1.55;
      }

      .dialog .speaker {
        font-family: var(--pixel-h);
        font-size: 0.65rem;
        color: var(--pink);
        margin-bottom: 0.55rem;
        letter-spacing: 0.06em;
      }

      .dialog-arrow {
        text-align: right;
        font-family: var(--pixel-h);
        font-size: 0.7rem;
        color: var(--gold);
        margin-top: 0.6rem;
      }

      .dialog em {
        color: var(--gold);
        font-style: normal;
      }

      .dialog .red {
        color: var(--red);
      }

      /* ---------- nav ---------- */
      .nav-menu {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 0;
        margin: 2.5rem 0.5rem 1.5rem;
        background: var(--box);
        border: 4px solid var(--frame);
        box-shadow:
          0 0 0 4px var(--bg),
          0 0 0 8px var(--frame);
      }

      .nav-menu a {
        font-family: var(--pixel-h);
        font-size: 0.7rem;
        color: var(--text);
        text-decoration: none;
        text-align: center;
        padding: 0.95rem 0.5rem;
        border-right: 2px solid var(--bg);
        position: relative;
        transition:
          background 0.1s ease,
          color 0.1s ease;
      }

      .nav-menu a:last-child {
        border-right: none;
      }

      .nav-menu a:hover {
        background: var(--gold);
        color: var(--bg);
      }

      .nav-menu a:hover::before {
        content: "▶";
        position: absolute;
        left: 0.4rem;
        top: 50%;
        transform: translateY(-50%);
        animation: blink 0.5s steps(2) infinite;
      }

      .nav-menu a.alert {
        color: var(--pink);
      }

      .nav-menu a.alert:hover {
        background: var(--pink);
        color: var(--bg);
      }

      /* ---------- actions ---------- */
      .quest-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin: 1.5rem 0.5rem 0.5rem;
      }

      .quest-btn {
        font-family: var(--pixel-h);
        font-size: 0.7rem;
        text-decoration: none;
        padding: 0.85rem 1.2rem;
        background: var(--box);
        color: var(--text);
        border: 3px solid var(--frame);
        position: relative;
        transition: transform 0.1s ease;
        line-height: 1.3;
      }

      .quest-btn::before {
        content: "▶ ";
        color: var(--gold);
        opacity: 0;
        transition: opacity 0.1s ease;
      }

      .quest-btn:hover {
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0 0 var(--gold);
      }

      .quest-btn:hover::before {
        opacity: 1;
      }

      .quest-btn.gold {
        background: var(--gold);
        color: var(--bg);
        border-color: var(--gold);
      }

      .quest-btn.gold:hover {
        box-shadow: 4px 4px 0 0 var(--frame);
      }

      .quest-btn.pink {
        background: var(--pink);
        color: var(--bg);
        border-color: var(--pink);
      }

      .quest-btn.pink:hover {
        box-shadow: 4px 4px 0 0 var(--frame);
      }

      /* ---------- sections ---------- */
      .section-title {
        font-family: var(--pixel-h);
        font-size: clamp(0.85rem, 2vw, 1.1rem);
        color: var(--gold);
        margin: 4rem 0.5rem 1.25rem;
        line-height: 1.3;
      }

      .section-title::before {
        content: "▣ ";
        color: var(--cyan);
      }

      /* ---------- quest list (work) ---------- */
      .quests {
        list-style: none;
        display: grid;
        gap: 1rem;
      }

      .quest {
        background: var(--box);
        border: 3px solid var(--frame);
        padding: 1rem 1.25rem;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 1rem;
        align-items: center;
        text-decoration: none;
        color: var(--text);
        transition:
          background 0.1s ease,
          transform 0.1s ease;
        position: relative;
      }

      .quest::before {
        content: "▶";
        font-family: var(--pixel-h);
        font-size: 0.7rem;
        color: var(--gold);
        opacity: 0;
        transition: opacity 0.1s ease;
        position: absolute;
        left: 0.4rem;
      }

      .quest:hover {
        background: var(--box-light);
        transform: translateX(0.5rem);
      }

      .quest:hover::before {
        opacity: 1;
        animation: blink 0.5s steps(2) infinite;
      }

      .quest-num {
        font-family: var(--pixel-h);
        font-size: 0.85rem;
        color: var(--cyan);
        min-width: 2.5rem;
      }

      .quest-info {
        font-family: var(--pixel-b);
        font-size: 1.15rem;
        line-height: 1.45;
      }

      .quest-name {
        font-family: var(--pixel-h);
        font-size: 0.75rem;
        color: var(--gold);
        line-height: 1.4;
        margin-bottom: 0.35rem;
        display: block;
      }

      .quest-desc {
        font-family: var(--pixel-b);
        font-size: 1.15rem;
        color: var(--text-dim);
        line-height: 1.45;
        display: block;
      }

      .quest-arrow {
        font-family: var(--pixel-h);
        font-size: 0.7rem;
        color: var(--cyan);
      }

      /* ---------- writing scrolls ---------- */
      .scrolls {
        list-style: none;
        display: grid;
        gap: 1rem;
      }

      .scroll {
        background: var(--box);
        border: 3px solid var(--frame);
        padding: 1.1rem 1.3rem;
        text-decoration: none;
        color: var(--text);
        display: block;
        transition:
          background 0.1s ease,
          transform 0.1s ease;
      }

      .scroll:hover {
        background: var(--box-light);
        transform: translateX(0.5rem);
      }

      .scroll-meta {
        display: flex;
        gap: 0.85rem;
        align-items: center;
        margin-bottom: 0.45rem;
        font-family: var(--pixel-h);
        font-size: 0.55rem;
        color: var(--cyan);
        letter-spacing: 0.06em;
      }

      .scroll-meta .new {
        background: var(--pink);
        color: var(--bg);
        padding: 0.18rem 0.4rem;
        font-size: 0.48rem;
      }

      .scroll-title {
        font-family: var(--pixel-h);
        font-size: 0.78rem;
        color: var(--gold);
        line-height: 1.45;
        margin-bottom: 0.4rem;
      }

      .scroll-desc {
        font-family: var(--pixel-b);
        font-size: 1.15rem;
        color: var(--text-dim);
      }

      .all-essays {
        display: inline-block;
        margin-top: 1.25rem;
        font-family: var(--pixel-h);
        font-size: 0.65rem;
        color: var(--bg);
        background: var(--gold);
        text-decoration: none;
        padding: 0.85rem 1.2rem;
        border: 3px solid var(--gold);
        transition: transform 0.1s ease;
      }

      .all-essays:hover {
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0 0 var(--frame);
      }

      /* ---------- subscribe (NPC) ---------- */
      .npc-box {
        margin-top: 1rem;
        background: var(--box);
        border: 4px solid var(--frame);
        padding: 1.5rem;
        box-shadow:
          0 0 0 4px var(--bg),
          0 0 0 8px var(--frame);
      }

      .npc-row {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1rem;
        align-items: start;
        margin-bottom: 1.25rem;
      }

      .npc-emoji {
        font-size: 2.5rem;
        line-height: 1;
        font-family: var(--pixel-b);
      }

      .npc-speech {
        font-family: var(--pixel-b);
        font-size: 1.2rem;
        line-height: 1.5;
      }

      .npc-speech .speaker {
        font-family: var(--pixel-h);
        font-size: 0.6rem;
        color: var(--pink);
        margin-bottom: 0.5rem;
        display: block;
      }

      .substack-frame {
        background: var(--bg-deep);
        padding: 0.75rem;
        border: 2px solid var(--frame-dim);
      }

      /* ---------- footer ---------- */
      .colophon {
        margin-top: 4rem;
        font-family: var(--pixel-b);
        font-size: 1.15rem;
        line-height: 1.5;
        text-align: center;
        padding: 2rem 1rem 0;
        border-top: 2px dashed var(--frame-dim);
      }

      .colophon-links {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        justify-content: center;
        margin: 1.25rem 0;
      }

      .colophon-links a {
        font-family: var(--pixel-h);
        font-size: 0.55rem;
        color: var(--text);
        text-decoration: none;
        padding: 0.5rem 0.7rem;
        border: 2px solid var(--frame);
        transition:
          background 0.1s ease,
          color 0.1s ease;
        letter-spacing: 0.05em;
      }

      .colophon-links a:hover {
        background: var(--gold);
        color: var(--bg);
        border-color: var(--gold);
      }

      .colophon-links a.back {
        background: var(--pink);
        color: var(--bg);
        border-color: var(--pink);
      }

      .colophon-blessing {
        font-family: var(--pixel-h);
        font-size: 0.7rem;
        color: var(--gold);
        margin: 1rem 0;
        line-height: 1.5;
      }

      .colophon-note {
        font-family: var(--pixel-b);
        font-size: 1rem;
        color: var(--text-dim);
      }

      /* ---------- entrance ---------- */
      @keyframes pop-in {
        from {
          opacity: 0;
          transform: scale(0.85);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      .title-screen,
      .pixel-box,
      .nav-menu {
        animation: pop-in 0.4s cubic-bezier(0.4, 1.6, 0.5, 1) both;
      }

      .pixel-box {
        animation-delay: 0.2s;
      }
      .nav-menu {
        animation-delay: 0.5s;
      }

      /* ---------- mobile ---------- */
      @media (max-width: 720px) {
        body {
          font-size: 19px;
        }

        main {
          padding: 1rem 0.75rem 3rem;
        }

        .character {
          grid-template-columns: 1fr;
          gap: 1.25rem;
          text-align: center;
        }

        .portrait-frame {
          margin: 0 auto;
        }

        .stat-row {
          grid-template-columns: 5rem 1fr;
          text-align: left;
        }

        .nav-menu {
          grid-template-columns: 1fr 1fr;
        }

        .nav-menu a {
          border-bottom: 2px solid var(--bg);
          font-size: 0.62rem;
          padding: 0.85rem 0.4rem;
        }

        .nav-menu a:nth-child(2) {
          border-right: none;
        }

        .nav-menu a:nth-child(3),
        .nav-menu a:nth-child(4) {
          border-bottom: none;
        }

        .quest {
          grid-template-columns: 1fr;
          gap: 0.5rem;
        }

        .quest-arrow,
        .quest-num {
          display: none;
        }

        .title-screen-jumbo {
          font-size: 1.5rem;
          text-shadow:
            2px 2px 0 var(--pink),
            4px 4px 0 var(--bg-deep);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-delay: 0s !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="title-screen">
        <h1 class="title-screen-jumbo">ADITYA<br />ASWANI</h1>
        <p class="title-screen-sub">★ A PERSONAL WEBSITE ★</p>
        <p class="press-start">— PRESS [<span class="blink">A</span>] TO BEGIN —</p>
      </div>

      <div class="pixel-box">
        <div class="character">
          <div class="portrait-frame">
            <img src="/aditya-640.webp" alt="Aditya Aswani" />
          </div>

          <div class="character-info">
            <h2 class="character-name">ADITYA ASWANI · LV.28</h2>

            <div class="stat-row">
              <span class="label">CLASS</span>
              <span class="value">DEFENDANT / MONK</span>
            </div>
            <div class="stat-row">
              <span class="label">HP</span>
              <span class="value green"
                >100/100 <span class="hp-bar"
                  ><span class="hp-fill"></span></span
                ></span
              >
            </div>
            <div class="stat-row">
              <span class="label">MP</span>
              <span class="value">infinity</span>
            </div>
            <div class="stat-row">
              <span class="label">EQUIP</span>
              <span class="value">cushion · pen · zazen</span>
            </div>
            <div class="stat-row">
              <span class="label">QUEST</span>
              <span class="value red">free the dogs</span>
            </div>
          </div>
        </div>

        <div class="dialog">
          <p class="speaker">▾ NARRATOR</p>
          <p>
            A writer, a Buddhist meditator, and an animal-rights defendant —
            currently facing a <em>felony charge</em> for rescuing dogs from a
            <em>research lab</em>. He keeps his work, his sanghas, and his
            essays in this small <em>encampment</em> on the open web.
          </p>
          <p class="dialog-arrow blink">▼</p>
        </div>
      </div>

      <nav class="nav-menu">
        <a href="#work">▸ WORK</a>
        <a href="#writing">▸ WRITING</a>
        <a href="/contact/">▸ CONTACT</a>
        <a class="alert" href={heroLinks.petition} target="_blank" rel="noopener noreferrer">⚠ PETITION</a>
      </nav>

      <div class="quest-actions">
        <a class="quest-btn gold" href={heroLinks.essay} target="_blank" rel="noopener noreferrer"
          >READ LATEST ESSAY</a
        >
        <a class="quest-btn pink" href={heroLinks.petition} target="_blank" rel="noopener noreferrer"
          >SIGN THE PETITION</a
        >
      </div>

      <h3 class="section-title" id="work">CHAPTER 1 · ACTIVE QUESTS</h3>
      <ol class="quests">
        {
          projects.map((project) => (
            <li>
              <a
                class="quest"
                href={project.link}
                target={project.link.startsWith("http") ? "_blank" : null}
                rel={
                  project.link.startsWith("http")
                    ? "noopener noreferrer"
                    : null
                }
              >
                <span class="quest-num">#{project.number}</span>
                <span class="quest-info">
                  <span class="quest-name">{project.title}</span>
                  <span class="quest-desc">{project.description}</span>
                </span>
                <span class="quest-arrow">▶</span>
              </a>
            </li>
          ))
        }
      </ol>

      <h3 class="section-title" id="writing">CHAPTER 2 · WRITTEN SCROLLS</h3>
      <ol class="scrolls">
        {
          posts.map((post, i) => (
            <li>
              <a
                class="scroll"
                href={post.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="scroll-meta">
                  {i === 0 && <span class="new">NEW</span>}
                  <span>· {post.date}</span>
                </div>
                <h4 class="scroll-title">{post.title}</h4>
                <p class="scroll-desc">{post.description}</p>
              </a>
            </li>
          ))
        }
      </ol>

      <a class="all-essays" href={heroLinks.substack} target="_blank" rel="noopener noreferrer">▶ ALL ESSAYS</a>

      <h3 class="section-title" id="subscribe">CHAPTER 3 · SAVE POINT</h3>
      <div class="npc-box">
        <div class="npc-row">
          <div class="npc-emoji">📜</div>
          <div class="npc-speech">
            <span class="speaker">▾ THE INNKEEPER</span>
            <p>
              "Welcome, traveler! Drop your scroll here and I&rsquo;ll send word
              when there&rsquo;s a <em style="color: var(--gold);">new essay</em
              > on the wind. No spam, no creatures. Press <em
                style="color: var(--gold);">[ENTER]</em
              > to subscribe."
            </p>
          </div>
        </div>
        <div class="substack-frame">
          <iframe
            src={heroLinks.substackEmbed}
            title="Subscribe to Aditya Aswani's Substack"
            width="100%"
            height="150"
            style="border: none; background: transparent; display: block; overflow: hidden;"></iframe>
        </div>
      </div>

