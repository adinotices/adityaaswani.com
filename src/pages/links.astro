---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Links — Aditya Aswani"
  description="Aditya Aswani — Buddhist, felony defendant for rescuing puppies, Operations Lead at Contemplative Semester, Founder of PausePal."
  ogImage="/og-links.jpg"
>
  <main class="links-page">
    <button class="theme-toggle" aria-label="Toggle theme">
      <span class="theme-icon moon">🌙</span>
      <span class="theme-icon sun">☀️</span>
    </button>
    <header class="header" style="--delay: 0s">
      <div class="avatar">
        <img src="/aditya-photo-new.jpg" alt="Aditya Aswani" />
      </div>
      <h1>Aditya Aswani</h1>
      <p class="bio">
        Buddhist · Felony defendant for rescuing puppies<br />
        Operations Lead at Contemplative Semester · Founder of PausePal
      </p>
    </header>

    <section class="link-section" style="--delay: 0.1s">
      <a class="link-card link-card--featured" href="https://www.zeffy.com/en-US/ticketing/defending-compassion-leadership-summit-nyc" target="_blank" rel="noopener noreferrer">
        <span class="featured-badge">Saturday, July 25th</span>
        <p class="link-title">Join us in NYC for our Leadership Summit</p>
        <p class="link-desc">Help us build a 10,000 strong movement to shut down Marshall BioResources</p>
      </a>
    </section>

    <section class="link-section" style="--delay: 0.2s">
      <a class="link-card" href="https://essays.adityaaswani.com" target="_blank" rel="noopener noreferrer">
        <p class="link-title">Subscribe (for free) to my blog</p>
        <p class="link-desc">Read or listen to my essays on animal liberation and mindfulness</p>
      </a>

      <a class="link-card" href="https://savethedogs.io" target="_blank" rel="noopener noreferrer">
        <p class="link-title">Sign the petition — help us get to 200k!</p>
        <p class="link-desc">Help free the dogs at Ridglan Farms</p>
      </a>

      <a class="link-card" href="https://www.zeffy.com/en-US/donation-form/support-mass-nonviolent-action-to-rescue-the-ridglan-dogs" target="_blank" rel="noopener noreferrer">
        <p class="link-title">Donate to our legal defense fund</p>
        <p class="link-desc">Support us as we go to court to defend our right to rescue abused animals</p>
      </a>

      <a class="link-card" href="/support">
        <p class="link-title">Support my work</p>
        <p class="link-desc">Help keep Sutam, PausePal and my other free projects going</p>
      </a>
    </section>

    <section class="link-section" style="--delay: 0.3s">
      <h2 class="section-label">Other projects</h2>

      <a class="link-card" href="https://www.contemplativesemester.org/" target="_blank" rel="noopener noreferrer">
        <p class="link-title">Contemplative Semester</p>
        <p class="link-desc">A 3-month immersion in meditation and community for young adults</p>
      </a>

      <a class="link-card" href="https://pausepal.co/" target="_blank" rel="noopener noreferrer">
        <p class="link-title">PausePal</p>
        <p class="link-desc">Find your meditation accountability buddy</p>
      </a>
    </section>

