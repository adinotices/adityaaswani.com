---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { identity, products, statusLabel, socials } from '../data/site';

const links = [
  { href: 'https://savethedogs.io', title: 'Sign the petition: help us get to 200k!', desc: 'Help free the dogs at Ridglan Farms', ext: true },
  { href: 'https://www.zeffy.com/en-US/donation-form/they-freed-the-dogs-now-51-of-them-face-felony-charges', title: 'Donate to our legal defense fund', desc: 'Support us as we go to court to defend our right to rescue abused animals', ext: true },
  { href: '/support', title: 'Support my work', desc: 'Help keep Sutam, PausePal and my other free projects going', ext: false },
];
const others = [
  { href: 'https://www.contemplativesemester.org/', title: 'Contemplative Semester', desc: 'A 3-month immersion in meditation and community for young adults' },
  { href: 'https://pausepal.co/', title: 'PausePal', desc: 'Find your meditation accountability buddy' },
];
---
<Layout
  title="Links — Aditya Aswani"
  description="Aditya Aswani — Buddhist, felony defendant for rescuing puppies, Operations Lead at Contemplative Semester, Founder of PausePal."
  ogImage="/og-links.jpg"
>
  <Navigation compact />
  <main id="main" class="wrap">
    <header class="head">
      <img
        src={identity.photo.src(320)}
        srcset={identity.photo.widths.map((w) => `${identity.photo.src(w)} ${w}w`).join(', ')}
        sizes="72px" width="320" height="480" alt={identity.photo.alt} fetchpriority="high"
      />
      <div>
        <h1>Aditya Aswani</h1>
        <p class="bio">Buddhist · Felony defendant for rescuing puppies<br />Operations Lead at Contemplative Semester · Founder of PausePal</p>
      </div>
    </header>

    <a class="featured" href="https://essays.adityaaswani.com" target="_blank" rel="noopener">
      <span class="label">Start here</span>
      <span class="ft">Subscribe (for free) to my blog</span>
      <span class="fd">Read or listen to my essays on animal liberation and mindfulness</span>
      <span class="sr-only">(opens in a new tab)</span>
    </a>

    <ul class="rows">
      {links.map((l) => (
        <li><a href={l.href} target={l.ext ? '_blank' : undefined} rel={l.ext ? 'noopener' : undefined}>
          <span class="t">{l.title}</span><span class="d">{l.desc}</span>{l.ext && <span class="sr-only">(opens in a new tab)</span>}
        </a></li>
      ))}
    </ul>

    <section aria-labelledby="b-h">
      <h2 id="b-h" class="label-big">Things I'm building</h2>
      <ul class="rows compact">
        {products.map((p) => (
          <li>
            <a href={p.url ?? '/#newsletter'}>
              <span class="t">{p.name}</span>
              <span class="label st">{statusLabel[p.status]}</span>
              <span class="d">{p.pitch.split(/(?<=[.:])\s/)[0]}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="o-h">
      <h2 id="o-h" class="label-big">Other projects</h2>
      <ul class="rows">
        {others.map((l) => (
          <li><a href={l.href} target="_blank" rel="noopener"><span class="t">{l.title}</span><span class="d">{l.desc}</span><span class="sr-only">(opens in a new tab)</span></a></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="f-h">
      <h2 id="f-h" class="label-big">Follow me elsewhere</h2>
      <ul class="soc">
        {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}
      </ul>
    </section>

    <section aria-labelledby="s-h">
      <h2 id="s-h" class="label-big">Get my essays by email</h2>
      <p class="note">No spam. Unsubscribe anytime.</p>
      <form action="https://adityaaswani.substack.com/api/v1/free?nojs=true" method="post" target="_blank">
        <label for="lemail" class="label">Email address</label>
        <div class="field">
          <input id="lemail" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
          <button type="submit" class="button solid">Subscribe<span class="sr-only"> (opens in a new tab)</span></button>
        </div>
      </form>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  main { padding-block: 2rem 1rem; }
  .head { display: flex; gap: 1.1rem; align-items: center; margin-bottom: 2rem; }
  .head img { width: 72px; height: 108px; object-fit: cover; border: 1px solid var(--rule); filter: grayscale(.25) sepia(.1); flex: none; }
  h1 { font-size: clamp(2rem, 1.4rem + 2.5vw, 2.6rem); font-weight: 380; }
  .bio { color: var(--muted); font-size: .95em; line-height: 1.45; margin-top: .4rem; font-style: italic; }
  .featured { display: block; padding-block: 1.25rem; border-block: 1px solid var(--ink); text-decoration: none; margin-bottom: .25rem; }
  .ft { display: block; font-size: 1.6em; line-height: 1.2; margin-top: .25rem; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: .18em; }
  .fd { display: block; color: var(--muted); margin-top: .35rem; }
  .featured:hover .ft { color: var(--accent); }
  section { margin-top: 2.5rem; }
  section > h2 { font-size: 1.05em; font-weight: 500; margin-bottom: .5rem; }
  .rows li { border-bottom: 1px solid var(--rule); }
  .rows a { display: block; padding-block: .95rem; text-decoration: none; }
  .t { display: inline; font-size: 1.2em; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: .18em; }
  .rows a:hover .t { color: var(--accent); }
  .d { display: block; color: var(--muted); font-size: .95em; margin-top: .15rem; }
  .compact .st { margin-left: .75rem; }
  .soc { display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
  .soc a { display: inline-flex; align-items: center; min-height: 44px; }
  .note { color: var(--muted); font-size: .95em; margin-bottom: .75rem; }
  .field { display: flex; flex-wrap: wrap; gap: .75rem; }
  input[type="email"] { flex: 1 1 14rem; min-height: 48px; padding: .4rem .2rem; font: inherit; color: var(--ink); background: transparent; border: 0; border-bottom: 1px solid var(--ink); border-radius: 0; }
  input[type="email"]::placeholder { color: var(--muted); opacity: 1; }
  :global([data-theme="dark"]) .head img { filter: grayscale(.25) sepia(.1) brightness(.88); }
</style>
