    <section class="subscribe-section" style="--delay: 0.5s">
      <p class="subscribe-title">Get my essays by email</p>
      <p class="subscribe-desc">No spam. Unsubscribe anytime.</p>
      <div class="substack-wrapper">
        <iframe
          src="https://adityaaswani.substack.com/embed"
          title="Subscribe to Aditya Aswani's Substack"
          width="100%"
          height="150"
          style="border: none; background: transparent; display: block; overflow: hidden;"
        ></iframe>
      </div>
    </section>

    <footer class="lp-footer" style="--delay: 0.6s">
      <p>May all beings be happy, healthy, and safe.</p>
      <p><a href="https://adityaaswani.com">adityaaswani.com</a></p>
    </footer>
  </main>
</Layout>

<style>
  .links-page {
    --lp-bg: #fefdf8;
    --lp-text-primary: #1a1a1a;
    --lp-text-secondary: #555;
    --lp-text-tertiary: #888;
    --lp-border: rgba(0, 0, 0, 0.08);
    --lp-card-bg: #ffffff;
    --lp-secondary-bg: #f5f3eb;
    --lp-link-color: #1a1a1a;
  }

  @media (prefers-color-scheme: dark) {
    .links-page {
      --lp-bg: #1a1a1a;
      --lp-text-primary: #f5f3eb;
      --lp-text-secondary: #b8b6ad;
      --lp-text-tertiary: #888;
      --lp-border: rgba(255, 255, 255, 0.1);
      --lp-card-bg: #242424;
      --lp-secondary-bg: #2a2a2a;
      --lp-link-color: #f5f3eb;
    }
  }

  .links-page {
    max-width: 600px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    background: var(--lp-bg);
    color: var(--lp-text-primary);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    min-height: 100vh;
  }

  /* Override global dark body background for this page */
  :global(body):has(.links-page) {
    background: #fefdf8;
  }

  @media (prefers-color-scheme: dark) {
    :global(body):has(.links-page) {
      background: #1a1a1a;
    }
  }

  /* data-theme overrides (manual toggle wins over prefers-color-scheme) */
  :global([data-theme="dark"]) .links-page {
    --lp-bg: #1a1a1a;
    --lp-text-primary: #f5f3eb;
    --lp-text-secondary: #b8b6ad;
    --lp-text-tertiary: #888;
    --lp-border: rgba(255, 255, 255, 0.1);
    --lp-card-bg: #242424;
