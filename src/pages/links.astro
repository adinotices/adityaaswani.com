<script>
  // Theme attribute is set synchronously by the inline script in Layout.astro <head>.
  // Only persist on explicit toggle so the site keeps following system theme until then.
  const persistTheme = (theme: string) => {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  };

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelector('.theme-toggle')?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      persistTheme(current === 'dark' ? 'light' : 'dark');
    });
  });
</script>
