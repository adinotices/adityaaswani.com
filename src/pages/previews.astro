---
const designs = [
  {
    slug: "preview",
    name: "Editorial · Light",
    descriptor: "Personal quarterly. Cream paper, ink serif, forest-green italics.",
    fonts: "Fraunces · Source Serif 4",
    palette: ["#f1ead9", "#1b1612", "#2c4a36"],
  },
  {
    slug: "preview-dark",
    name: "Editorial · Night",
    descriptor: "Library at midnight. Warm ink black, parchment, candle gold.",
    fonts: "Fraunces · Source Serif 4",
    palette: ["#0f0d0a", "#ece1c8", "#d6a84a"],
  },
  {
    slug: "preview-brutalist",
    name: "Zine · Manifesto",
    descriptor: "Punk activist. Bowlby One headlines, photocopy halftone, red overprint.",
    fonts: "Bowlby One · Special Elite",
    palette: ["#f0e8d6", "#0a0a0a", "#d62828"],
  },
  {
    slug: "preview-japanese",
    name: "Mincho · Stillness",
    descriptor: "Sumi ink, washi paper, asymmetric breath, hanko seal.",
    fonts: "Shippori Mincho · Cormorant Garamond",
    palette: ["#f7f4ed", "#1a1715", "#a8281e"],
  },
  {
    slug: "preview-pixel",
    name: "16-Bit · Profile",
    descriptor: "RPG character screen. CRT scanlines, dialog box, HP bar.",
    fonts: "Press Start 2P · VT323",
    palette: ["#14122a", "#ffc83d", "#ff5c9c"],
  },
  {
    slug: "preview-anime",
    name: "Shounen · Action",
    descriptor: "Bungee Inline title, crimson + gold tactical, jagged speech bubble, 自由 watermark.",
    fonts: "Bungee Inline · Black Ops One · Saira",
    palette: ["#0a0a12", "#d3252e", "#f5c518"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Design Previews — Aditya Aswani</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <style is:global>
      :root {
        --bg: #f5f1e8;
        --bg-deep: #ebe6d6;
        --ink: #1a1612;
        --ink-soft: #6a6358;
        --ink-faint: #a8a092;
        --hair: #c8bfa8;
        --accent: #2c4a36;
        --serif: "Fraunces", ui-serif, Georgia, serif;
        --mono: "JetBrains Mono", ui-monospace, monospace;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--serif);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }

      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem 5rem;
      }

      a {
        color: inherit;
      }

      header {
        margin-bottom: 4rem;
        max-width: 720px;
      }

      .eyebrow {
        font-family: var(--mono);
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ink-faint);
        margin-bottom: 1rem;
      }

      h1 {
        font-family: var(--serif);
        font-weight: 360;
        font-variation-settings: "opsz" 144;
        font-size: clamp(2.5rem, 6vw, 4rem);
        line-height: 1.05;
        letter-spacing: -0.025em;
        margin-bottom: 1.5rem;
      }

      h1 em {
        color: var(--accent);
      }

      header p {
        font-family: var(--serif);
        font-size: 1.2rem;
        font-style: italic;
        color: var(--ink-soft);
        max-width: 600px;
        line-height: 1.5;
      }

      .live-link {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        margin-top: 1.5rem;
        font-family: var(--serif);
        font-style: italic;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--ink);
        padding-bottom: 0.15rem;
        font-size: 0.95rem;
      }

      .live-link:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
      }

      .card {
        position: relative;
        text-decoration: none;
        color: inherit;
        background: var(--bg-deep);
        border: 1px solid var(--hair);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition:
          transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
          box-shadow 0.3s ease;
      }

      .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px -20px rgba(40, 30, 20, 0.25);
      }

      .swatch {
        height: 200px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        font-family: var(--serif);
        text-align: center;
      }

      /* per-design swatches */
      .sw-preview {
        background: #f1ead9;
        color: #1b1612;
      }
      .sw-preview .sw-name {
        font-family: "Fraunces", serif;
        font-variation-settings: "opsz" 144;
        font-size: 3rem;
        font-weight: 400;
        letter-spacing: -0.04em;
        line-height: 0.9;
      }
      .sw-preview .sw-name em {
        font-style: italic;
        color: #2c4a36;
        display: block;
        padding-left: 0.8em;
      }

      .sw-preview-dark {
        background: #0f0d0a;
        color: #ece1c8;
        background-image:
          radial-gradient(ellipse at top, rgba(214, 168, 74, 0.15) 0%, transparent 60%);
      }
      .sw-preview-dark .sw-name {
        font-family: "Fraunces", serif;
        font-variation-settings: "opsz" 144;
        font-size: 3rem;
        font-weight: 400;
        letter-spacing: -0.04em;
        line-height: 0.9;
      }
      .sw-preview-dark .sw-name em {
        font-style: italic;
        color: #d6a84a;
        display: block;
        padding-left: 0.8em;
        text-shadow: 0 0 30px rgba(214, 168, 74, 0.5);
      }

      .sw-preview-brutalist {
        background: #f0e8d6;
        color: #0a0a0a;
        background-image: repeating-linear-gradient(
          0deg,
          transparent 0,
          transparent 2px,
          rgba(0, 0, 0, 0.025) 3px
        );
      }
      .sw-preview-brutalist .sw-name {
        font-family: "Fraunces", serif;
        font-weight: 700;
        font-size: 2.6rem;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        line-height: 0.85;
      }
      .sw-preview-brutalist .sw-name em {
        font-style: normal;
        color: #d62828;
        display: block;
      }
      .sw-preview-brutalist::after {
        content: "FELONY";
        position: absolute;
        top: 1rem;
        right: 1rem;
        font-family: "Fraunces", serif;
        font-weight: 700;
        font-size: 0.85rem;
        color: #d62828;
        border: 2px solid #d62828;
        padding: 0.35rem 0.55rem;
        transform: rotate(8deg);
        letter-spacing: 0.1em;
      }

      .sw-preview-japanese {
        background: #f7f4ed;
        color: #1a1715;
      }
      .sw-preview-japanese .sw-name {
        font-family: "Fraunces", serif;
        font-weight: 360;
        font-size: 2.6rem;
        letter-spacing: 0;
        line-height: 1.1;
      }
      .sw-preview-japanese .sw-name em {
        font-style: italic;
        font-weight: 300;
        color: #6a6358;
        display: block;
        padding-left: 1.2em;
        font-size: 0.85em;
      }
      .sw-preview-japanese::after {
        content: "縁";
        position: absolute;
        top: 1.2rem;
        right: 1.2rem;
        font-family: serif;
        font-size: 1.5rem;
        color: #a8281e;
        border: 1.5px solid #a8281e;
        padding: 0.5rem 0.55rem 0.4rem;
        line-height: 1;
        transform: rotate(-3deg);
      }

      .sw-preview-pixel {
        background:
          linear-gradient(180deg, #14122a 0%, #0a0820 100%);
        color: #ffc83d;
        background-image:
          linear-gradient(180deg, #14122a 0%, #0a0820 100%),
          repeating-linear-gradient(
            0deg,
            transparent,
            transparent 2px,
            rgba(0, 0, 0, 0.5) 3px,
            rgba(0, 0, 0, 0.5) 4px
          );
        background-blend-mode: multiply;
      }
      .sw-preview-pixel .sw-name {
        font-family: "JetBrains Mono", monospace;
        font-weight: 500;
        font-size: 1.5rem;
        line-height: 1.2;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        text-shadow: 3px 3px 0 #ff5c9c, 6px 6px 0 #0a0820;
      }
      .sw-preview-pixel .sw-name em {
        font-style: normal;
        color: #ffc83d;
        display: block;
      }
      .sw-preview-pixel::before {
        content: "★ LV.28 ★";
        position: absolute;
        bottom: 1rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.6rem;
        color: #5cd9e6;
        letter-spacing: 0.2em;
      }

      .sw-preview-anime {
        background:
          radial-gradient(ellipse at top right, rgba(211, 37, 46, 0.35) 0%, transparent 55%),
          linear-gradient(180deg, #0a0a12 0%, #050508 100%);
        color: #ede8dc;
        position: relative;
        overflow: hidden;
      }
      .sw-preview-anime .sw-name {
        font-family: "Fraunces", serif;
        font-weight: 700;
        font-size: 2.4rem;
        line-height: 0.9;
        letter-spacing: -0.02em;
        color: #ede8dc;
        text-shadow: 4px 4px 0 #9b1a22;
        text-transform: uppercase;
        position: relative;
        z-index: 2;
      }
      .sw-preview-anime .sw-name em {
        font-style: normal;
        color: #f5c518;
        display: block;
        text-shadow: 4px 4px 0 #050508;
      }
      .sw-preview-anime::before {
        content: "自由";
        position: absolute;
        right: -12px;
        top: -10px;
        font-family: "Noto Sans JP", "Yu Gothic", sans-serif;
        font-weight: 900;
        font-size: 11rem;
        line-height: 0.8;
        color: #d3252e;
        opacity: 0.12;
        z-index: 0;
        letter-spacing: -0.04em;
      }
      .sw-preview-anime::after {
        content: "▲ ACTIVE";
        position: absolute;
        bottom: 0.85rem;
        left: 1rem;
        font-family: "JetBrains Mono", monospace;
        font-weight: 500;
        font-size: 0.6rem;
        letter-spacing: 0.2em;
        color: #f5c518;
        z-index: 2;
      }

      .meta {
        padding: 1.25rem 1.5rem 1.5rem;
        border-top: 1px solid var(--hair);
        background: var(--bg);
      }

      .meta-name {
        font-family: var(--serif);
        font-size: 1.1rem;
        font-weight: 500;
        margin-bottom: 0.4rem;
        letter-spacing: -0.005em;
      }

      .meta-descriptor {
        font-family: var(--serif);
        font-style: italic;
        font-size: 0.92rem;
        color: var(--ink-soft);
        line-height: 1.5;
        margin-bottom: 0.85rem;
      }

      .meta-fonts {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.05em;
        color: var(--ink-faint);
      }

      .palette {
        display: flex;
        gap: 0.3rem;
        margin-top: 0.6rem;
      }

      .palette span {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 1px solid var(--hair);
      }

      footer {
        margin-top: 5rem;
        padding-top: 2rem;
        border-top: 1px solid var(--hair);
        font-family: var(--serif);
        font-style: italic;
        font-size: 0.9rem;
        color: var(--ink-faint);
        text-align: center;
      }

      footer a {
        color: var(--ink);
        border-bottom: 1px solid var(--hair);
        text-decoration: none;
        padding-bottom: 0.1rem;
      }

      footer a:hover {
        border-bottom-color: var(--accent);
        color: var(--accent);
      }

      @keyframes reveal {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      header {
        animation: reveal 0.6s ease both;
      }

      .card {
        animation: reveal 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      }

      .card:nth-child(1) {
        animation-delay: 0.1s;
      }
      .card:nth-child(2) {
        animation-delay: 0.18s;
      }
      .card:nth-child(3) {
        animation-delay: 0.26s;
      }
      .card:nth-child(4) {
        animation-delay: 0.34s;
      }
      .card:nth-child(5) {
        animation-delay: 0.42s;
      }
      .card:nth-child(6) {
        animation-delay: 0.5s;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">Design exploration · Spring 2026</p>
        <h1>Six directions for the <em>same</em> site.</h1>
        <p>
          Each preview keeps the same content but commits fully to a different
          aesthetic. Click any card to see the full page.
        </p>
        <a class="live-link" href="/" target="_blank">View the live site →</a>
      </header>

      <div class="grid">
        {
          designs.map((design) => (
            <a class="card" href={`/${design.slug}/`}>
              <div class={`swatch sw-${design.slug}`}>
                <div class="sw-name">
                  Aditya
                  <em>Aswani.</em>
                </div>
              </div>
              <div class="meta">
                <h2 class="meta-name">{design.name}</h2>
                <p class="meta-descriptor">{design.descriptor}</p>
                <p class="meta-fonts">{design.fonts}</p>
                <div class="palette">
                  {design.palette.map((c) => (
                    <span style={`background: ${c}`} />
                  ))}
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <footer>
        <p>
          Built with <a href="https://astro.build/">Astro</a> &amp;
          <a href="https://www.anthropic.com/claude-code">Claude Code</a>
        </p>
      </footer>
    </main>
  </body>
</html>
