---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact — Aditya Aswani" description="Get in touch with Aditya Aswani for meaningful conversations and collaborations." ogImage="/aditya-photo.jpg">
  <Navigation />
  
  <main id="main" class="contact-page">
    <article class="content">
      <header class="page-header">
        <h1>Let's Connect</h1>
        <p class="lead">I'm always interested in meaningful conversations and collaborations</p>
      </header>
      
      <div class="contact-methods">
        <div class="contact-card">
          <div class="contact-icon">
            <svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 12.713l-11.985-9.713h23.971l-11.986 9.713zm-5.425-1.822l-6.575-5.329v12.501l6.575-7.172zm10.85 0l6.575 7.172v-12.501l-6.575 5.329zm-1.557 1.261l-3.868 3.135-3.868-3.135-8.11 8.848h23.956l-8.11-8.848z"/>
            </svg>
          </div>
          <h2>Email</h2>
          <p>Feel free to reach out for any questions, collaborations, or just to say hello.</p>
          <a href="mailto:hello@adityaaswani.com" class="contact-button">
            hello@adityaaswani.com
          </a>
        </div>
        
        <div class="contact-card">
          <div class="contact-icon">
            <svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
          </div>
          <h2>Response Time</h2>
          <p>I typically respond within 24-48 hours. For urgent matters, please mention it in your subject line.</p>
        </div>
      </div>
      
      <div class="topics">
        <h2>What I'd love to hear from you about:</h2>
        <ul>
          <li>Animal rights and activism</li>
          <li>Meditation and mindfulness practices</li>
          <li>Writing and creative projects</li>
          <li>Collaborations and partnerships</li>
          <li>Questions about my work or experiences</li>
          <li>Just saying hello! 👋</li>
        </ul>
      </div>

      <div class="feedback-section">
        <h2 id="share-feedback">Share your Feedback</h2>
        <p>I value all feedback! Constructive, positive, or just general thoughts.</p>
        
        <div class="feedback-options">
          <div class="feedback-card direct">
            <div class="feedback-icon">
              <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </div>
            <h3>Direct Feedback</h3>
            <p>If you'd like me to reply to your feedback, please email me directly.</p>
            <a href="mailto:hello@adityaaswani.com" class="feedback-button">
              Email Me
            </a>
          </div>

          <div class="feedback-card anonymous">
            <div class="feedback-icon">
              <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
              </svg>
            </div>
            <h3>Anonymous Feedback</h3>
            <p>Prefer to stay anonymous? Use this form (note: I won't be able to reply).</p>
            <a href="https://tally.so/r/dWQZlV" target="_blank" rel="noopener noreferrer" class="feedback-button">
              Anonymous Form
            </a>
          </div>
        </div>

        <div class="intermediaries">
          <h3>Through Someone Else</h3>
          <p>If you'd prefer to give your feedback through someone else, feel free to contact any of the following people!</p>
          
          <div class="intermediary-cards">
            <div class="intermediary-card">
              <h4>Pranab Sachi</h4>
              <div class="intermediary-links">
                <a href="https://www.pranabsachi.com/" target="_blank" rel="noopener noreferrer">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                  </svg>
                  Website
                </a>
                <a href="mailto:pranabsachi@gmail.com">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                  </svg>
                  Email
                </a>
              </div>
            </div>

            <div class="intermediary-card">
              <h4>Michelle Chai</h4>
              <div class="intermediary-links">
                <a href="https://www.youtube.com/user/brooklynchai" target="_blank" rel="noopener noreferrer">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.498 6.186a2.998 2.998 0 0 0-2.108-2.085C19.505 3.65 12 3.65 12 3.65s-7.505 0-9.39.451A2.998 2.998 0 0 0 .502 6.186C.05 8.07.05 12 .05 12s0 3.93.452 5.814a2.998 2.998 0 0 0 2.108 2.085c1.885.451 9.39.451 9.39.451s7.505 0 9.39-.451a2.998 2.998 0 0 0 2.108-2.085C23.95 15.93 23.95 12 23.95 12s0-3.93-.452-5.814zM9.75 15.568V8.432L15.5 12l-5.75 3.568z"/>
                  </svg>
                  YouTube
                </a>
                <a href="mailto:myc219@nyu.edu">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                  </svg>
                  Email
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>
  </main>
  
  <Footer />
</Layout>

<style>
  .contact-page { padding-block: clamp(2.5rem, 7vw, 5rem) 1rem; }
  .content { max-width: calc(var(--measure) + 2 * var(--pad)); margin-inline: auto; padding-inline: var(--pad); }
  h1 { font-size: clamp(2.4rem, 1.6rem + 3.4vw, 3.6rem); font-weight: 380; margin-bottom: 1rem; }
  .lead { font-size: 1.3em; font-style: italic; color: var(--muted); line-height: 1.45; margin-bottom: 1rem; }
  .contact-icon, .feedback-icon, .intermediary-links svg { display: none; }
  h2 { font-size: 1.35em; font-weight: 450; margin: 2.75rem 0 .75rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .contact-methods h2 { margin-top: 2rem; }
  h3 { font-size: 1.15em; font-weight: 500; margin: 1.5rem 0 .3rem; }
  h4 { font-size: 1.05em; font-weight: 500; }
  p { margin-bottom: .75rem; }
  .contact-card p, .feedback-card p, .intermediaries > p { color: var(--muted); }
  .contact-button, .feedback-button { display: inline-flex; align-items: center; min-height: 48px; padding: .4rem 1.4rem; border: 1px solid var(--ink); text-decoration: none; transition: background-color .2s, color .2s; margin-bottom: .75rem; }
  .contact-button:hover, .feedback-button:hover { background: var(--ink); color: var(--paper); }
  .topics ul li::before { content: "\2014\00a0"; color: var(--accent); }
  .topics li { padding-block: .1em; }
  .feedback-section { margin-top: 0; }
  .intermediary-card { margin-top: 1.25rem; padding-bottom: 1rem; border-bottom: 1px solid var(--rule); }
  .intermediary-links { display: flex; gap: 1.5rem; }
  .intermediary-links a { display: inline-flex; align-items: center; min-height: 44px; }
  .feedback-section > h2 { margin-top: 2.75rem; }
</style>
