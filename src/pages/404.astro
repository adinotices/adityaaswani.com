---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Wordmark from '../components/Wordmark.astro';
---

<Layout title="404 — Page Not Found" description="This page doesn't exist." noindex={true}>
  <Header />
  <main id="main" tabindex="-1" class="not-found">
    <Wordmark class="wm" />
    <h1>404</h1>
    <p>This page doesn't exist. Maybe I moved it, or maybe the link is a little off.</p>
    <a href="/" class="btn">Go home</a>
  </main>
  <Footer />
</Layout>

<style>
  .not-found { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 3rem 1.5rem; gap: 1.2rem; }
  .wm { width: min(70vw, 280px); height: auto; color: var(--ink); }
  h1 { font-size: clamp(4.5rem, 20vw, 8rem); color: var(--clay); line-height: 1; }
  p { font-size: 1.2rem; color: var(--ink-2); max-width: 26rem; }
  main:focus { outline: none; }
</style>
