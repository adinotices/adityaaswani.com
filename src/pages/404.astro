---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Wordmark from '../components/Wordmark.astro';
---

<Layout title="404 — Page Not Found" description="This page doesn't exist." noindex={true}>
  <Navigation />
  <main id="main" class="not-found">
    <div class="mark"><Wordmark label={false} /></div>
    <h1>404</h1>
    <p>This page doesn't exist.</p>
    <a href="/" class="btn">Go home <span aria-hidden="true">→</span></a>
  </main>
  <Footer />
</Layout>

<style>
  main { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 4rem var(--pad); max-width: calc(var(--measure) + 2 * var(--pad)); margin-inline: auto; width: 100%; }
  .mark { color: var(--ink); margin-bottom: 2.5rem; }
  .mark :global(.wordmark) { height: 2.2rem; }
  h1 { font-size: clamp(2.4rem, 1.6rem + 3.4vw, 3.6rem); font-weight: 380; margin-bottom: .75rem; }
  p { font-style: italic; color: var(--muted); font-size: 1.3em; margin-bottom: 1.5rem; }
  .btn { align-self: flex-start; display: inline-flex; align-items: center; min-height: 48px; padding: .4rem 1.5rem; border: 1px solid var(--ink); text-decoration: none; font-variant-caps: all-small-caps; letter-spacing: .09em; transition: background-color .2s, color .2s; }
  .btn:hover { background: var(--ink); color: var(--paper); }
</style>
