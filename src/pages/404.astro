---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Wordmark from '../components/Wordmark.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 — Page Not Found" description="This page doesn't exist." noindex={true}>
  <Header />
  <main id="main" class="not-found">
    <Wordmark mark class="big" />
    <p class="code">ERROR 404</p>
    <h1>Page not found</h1>
    <p>This page doesn't exist.</p>
    <a href="/" class="btn btn-primary">Go home →</a>
  </main>
  <Footer />
</Layout>

<style>
  .not-found { min-height: 70vh; display: grid; place-content: center; justify-items: start; gap: 1.1rem; padding: 3rem 1.25rem; max-width: 720px; margin: 0 auto; }
  .big { color: var(--accent); width: min(260px, 60vw); height: auto; }
  .code { font-family: var(--mono); color: var(--muted); font-size: 0.85rem; letter-spacing: 0.08em; }
  h1 { font-size: clamp(2.4rem, 7vw, 3.6rem); }
  p { color: var(--muted); font-size: 1.15rem; }
</style>
