---
import '../styles/global.css';
import frauncesUrl from '../assets/fonts/fraunces-latin-soft-normal.woff2?url';
import nunitoUrl from '../assets/fonts/nunito-sans-latin-wght-normal.woff2?url';
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description = "Aditya Aswani - Personal hub for projects and writings.", ogImage = "/og-default.jpg", noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, "https://adityaaswani.com").href;
const ogImageUrl = new URL(ogImage, "https://adityaaswani.com").href;
// Pixel sizes of the share images in public/, so crawlers can lay out the card before fetching.
const ogSizes: Record<string, [number, number]> = { "/og-default.jpg": [1200, 630], "/og-links.jpg": [1600, 1067] };
const ogSize = ogSizes[ogImage];
// Design-preview builds (PUBLIC_PREVIEW=1, deployed to Cloudflare Pages) are never
// indexed and never report to Plausible.
const isPreview = import.meta.env.PUBLIC_PREVIEW === "1";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* Production builds only: scripts/csp-integration.mjs fills in the policy with this page's inline-script hashes. */}
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content="__CSP__" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {(noindex || isPreview) && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (function(){var t=localStorage.getItem('theme')||(window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.setAttribute('data-theme',t);document.documentElement.classList.add('js');})();
    </script>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {ogSize && <meta property="og:image:width" content={String(ogSize[0])} />}
    {ogSize && <meta property="og:image:height" content={String(ogSize[1])} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preload" as="font" type="font/woff2" href={nunitoUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={frauncesUrl} crossorigin />
    <meta name="theme-color" content="#f8f1e3" />

    <!-- Privacy-friendly analytics by Plausible -->
    {!isPreview && <script async src="https://plausible.io/js/pa-bwqzj0WiW7cQd51RChC7F.js"></script>}
    {!isPreview && <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>}
    <!-- Cloudflare Web Analytics (cookieless) -->
    {!isPreview && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"cfcbbc56a1534a87bef6280a5026c2dd"}'></script>}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
