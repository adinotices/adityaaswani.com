    "links": { "name": "/links page", "prefixes": ["LINKS"] },
    "contact": { "name": "/contact and /learn-meditation", "prefixes": ["CONTACT", "MED", "EXT"] },
    "copy": { "name": "Copy-email buttons", "prefixes": ["COPY"] },
    "security": { "name": "Security headers and CSP", "prefixes": ["SEC"] },
