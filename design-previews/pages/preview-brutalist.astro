---
import { projects, posts, heroLinks } from "../data/previewContent";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Preview · Zine — Aditya Aswani</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bowlby+One&family=Special+Elite&family=Archivo+Black&family=Redaction+50&display=swap"
    />

    <style is:global>
      :root {
        --paper: #f0e8d6;
        --paper-deep: #e3d9c1;
        --ink: #0a0a0a;
        --ink-soft: #2c2c2c;
        --red: #d62828;
        --red-deep: #a51d1d;
        --display: "Bowlby One", "Archivo Black", system-ui, sans-serif;
        --slab: "Archivo Black", system-ui, sans-serif;
        --type: "Special Elite", "Courier New", monospace;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      ::selection {
        background: var(--ink);
        color: var(--red);
      }

      html {
        background: var(--paper);
      }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--type);
        font-size: 17px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        position: relative;
        overflow-x: hidden;
        min-height: 100vh;
        background-image:
          repeating-linear-gradient(
            0deg,
            rgba(0, 0, 0, 0.012) 0px,
            transparent 1px,
            transparent 3px,
            rgba(0, 0, 0, 0.012) 4px
          ),
          radial-gradient(
            circle at 50% 50%,
            rgba(0, 0, 0, 0.018) 1px,
            transparent 1px
          );
        background-size:
          100% 4px,
          5px 5px;
      }

      /* ---------- top bar ---------- */
      .barcode {
        background: var(--ink);
        color: var(--paper);
        padding: 0.4rem 1.5rem;
        font-family: var(--type);
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        display: flex;
        justify-content: space-between;
        align-items: center;
        white-space: nowrap;
        overflow: hidden;
      }

      .barcode-marquee {
        display: flex;
        gap: 2rem;
      }

      .barcode-marquee span::before {
        content: "//";
        margin-right: 0.5rem;
        color: var(--red);
      }

      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem 4rem;
      }

      a {
        color: inherit;
      }

      /* ---------- masthead ---------- */
      .masthead {
        padding: 2.5rem 0 1.5rem;
        position: relative;
      }

      .masthead-issue {
        font-family: var(--type);
        font-size: 0.85rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        border-top: 4px solid var(--ink);
        border-bottom: 1px solid var(--ink);
        padding: 0.5rem 0;
        margin-bottom: 1rem;
        display: flex;
        justify-content: space-between;
      }

      .masthead-issue strong {
        color: var(--red);
      }

      .masthead-title {
        font-family: var(--display);
        font-size: clamp(3.5rem, 11vw, 9rem);
        line-height: 0.85;
        letter-spacing: -0.03em;
        text-transform: uppercase;
        color: var(--ink);
      }

      .masthead-title .strike {
        position: relative;
        display: inline-block;
      }

      .masthead-title .strike::after {
        content: "";
        position: absolute;
        left: -2%;
        right: -2%;
        top: 48%;
        height: 0.18em;
        background: var(--red);
        transform: rotate(-2deg);
        pointer-events: none;
      }

      .masthead-title .red {
        color: var(--red);
      }

      .masthead-tagline {
        font-family: var(--type);
        font-size: 0.95rem;
        letter-spacing: 0.04em;
        margin-top: 1.25rem;
        max-width: 540px;
      }

      /* the rotated stamp */
      .stamp {
        position: absolute;
        top: 3.5rem;
        right: 1rem;
        font-family: var(--display);
        font-size: 1rem;
        letter-spacing: 0.08em;
        color: var(--red);
        border: 3px solid var(--red);
        padding: 0.55rem 0.9rem;
        text-transform: uppercase;
        transform: rotate(7deg);
        background: rgba(214, 40, 40, 0.04);
        line-height: 1;
        box-shadow:
          inset 0 0 0 1px rgba(214, 40, 40, 0.4),
          1px 1px 0 rgba(214, 40, 40, 0.18);
      }

      .stamp small {
        display: block;
        font-family: var(--type);
        font-size: 0.6rem;
        letter-spacing: 0.18em;
        margin-top: 0.18rem;
        color: var(--red-deep);
      }

      /* ---------- nav ---------- */
      .nav {
        font-family: var(--display);
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 0.05em;
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        border: 3px solid var(--ink);
        margin-bottom: 2.5rem;
      }

      .nav a {
        flex: 1 1 auto;
        text-align: center;
        padding: 0.85rem 1rem;
        text-decoration: none;
        border-right: 3px solid var(--ink);
        background: var(--paper);
        transition:
          background 0.15s ease,
          color 0.15s ease;
        white-space: nowrap;
      }

      .nav a:last-child {
        border-right: none;
      }

      .nav a:hover {
        background: var(--ink);
        color: var(--paper);
      }

      .nav a.alert {
        background: var(--red);
        color: var(--paper);
      }

      .nav a.alert:hover {
        background: var(--ink);
      }

      /* ---------- hero ---------- */
      .hero {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 2.5rem;
        margin-bottom: 4rem;
        align-items: start;
      }

      .hero-headline {
        font-family: var(--display);
        font-size: clamp(2rem, 5vw, 3.4rem);
        line-height: 0.95;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
      }

      .hero-headline .red {
        color: var(--red);
      }

      .hero-headline .underline {
        text-decoration: underline;
        text-decoration-thickness: 0.18em;
        text-underline-offset: -0.06em;
        text-decoration-skip-ink: none;
      }

      .lede {
        border-top: 2px solid var(--ink);
        border-bottom: 2px solid var(--ink);
        padding: 1.25rem 0;
        margin-bottom: 1.5rem;
        font-family: var(--type);
        font-size: 1.05rem;
        line-height: 1.65;
      }

      .lede strong {
        background: var(--ink);
        color: var(--paper);
        padding: 0.05em 0.3em;
      }

      .actions {
        display: flex;
        gap: 0;
        flex-wrap: wrap;
      }

      .btn {
        font-family: var(--display);
        font-size: 1rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        padding: 1rem 1.5rem;
        border: 3px solid var(--ink);
        background: var(--paper);
        color: var(--ink);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        transition:
          transform 0.12s ease,
          background 0.12s ease,
          color 0.12s ease;
        margin-right: -3px;
        position: relative;
      }

      .btn:hover {
        transform: translate(-3px, -3px);
        box-shadow: 6px 6px 0 0 var(--ink);
        z-index: 2;
      }

      .btn-red {
        background: var(--red);
        color: var(--paper);
        border-color: var(--ink);
      }

      .btn-red:hover {
        box-shadow: 6px 6px 0 0 var(--red-deep);
      }

      /* ---------- photo ---------- */
      .hero-photo-wrap {
        position: relative;
      }

      .photo-frame {
        position: relative;
        border: 3px solid var(--ink);
        background: var(--ink);
        padding: 0;
        transform: rotate(-1.5deg);
      }

      .photo-frame img {
        display: block;
        width: 100%;
        height: auto;
        filter: grayscale(1) contrast(1.6) brightness(0.92);
        mix-blend-mode: multiply;
      }

      .photo-frame::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(
          rgba(0, 0, 0, 0.55) 1px,
          transparent 1px
        );
        background-size: 4px 4px;
        mix-blend-mode: multiply;
        opacity: 0.45;
        pointer-events: none;
      }

      .photo-caption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2.2rem;
        font-family: var(--type);
        font-size: 0.85rem;
        text-align: center;
        background: var(--paper);
        padding: 0.4rem;
        border: 2px solid var(--ink);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        transform: rotate(0.8deg);
      }

      .tape {
        position: absolute;
        width: 110px;
        height: 28px;
        background: rgba(214, 40, 40, 0.5);
        background-image: repeating-linear-gradient(
          45deg,
          rgba(255, 255, 255, 0.2) 0,
          rgba(255, 255, 255, 0.2) 4px,
          transparent 4px,
          transparent 8px
        );
        border-left: 1px dashed rgba(0, 0, 0, 0.3);
        border-right: 1px dashed rgba(0, 0, 0, 0.3);
      }

      .tape-1 {
        top: -14px;
        left: 18%;
        transform: rotate(-8deg);
      }

      .tape-2 {
        bottom: -10px;
        right: 8%;
        transform: rotate(6deg);
        background: rgba(0, 0, 0, 0.55);
      }

      /* ---------- big rule ---------- */
      .rule-bar {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 4rem 0 2rem;
      }

      .rule-bar::before,
      .rule-bar::after {
        content: "";
        flex: 1;
        height: 6px;
        background: var(--ink);
      }

      .rule-bar h2 {
        font-family: var(--display);
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        text-transform: uppercase;
        letter-spacing: -0.02em;
        white-space: nowrap;
      }

      .rule-bar h2 .num {
        color: var(--red);
        margin-right: 0.25em;
      }

      /* ---------- entries ---------- */
      .entries {
        list-style: none;
        display: grid;
        gap: 0;
      }

      .entry {
        position: relative;
      }

      .entry-link {
        display: grid;
        grid-template-columns: 5rem 1fr auto;
        gap: 1.5rem;
        padding: 1.5rem 1rem;
        border-top: 3px solid var(--ink);
        text-decoration: none;
        color: var(--ink);
        align-items: center;
        background: var(--paper);
        transition:
          background 0.15s ease,
          color 0.15s ease,
          transform 0.15s ease;
      }

      .entry:last-child .entry-link {
        border-bottom: 3px solid var(--ink);
      }

      .entry-link:hover {
        background: var(--ink);
        color: var(--paper);
      }

      .entry-link:hover .entry-number {
        color: var(--red);
      }

      .entry-number {
        font-family: var(--display);
        font-size: 3rem;
        line-height: 1;
        color: var(--ink);
        transition: color 0.15s ease;
      }

      .entry-title {
        font-family: var(--display);
        font-size: clamp(1.2rem, 2.4vw, 1.7rem);
        text-transform: uppercase;
        letter-spacing: -0.01em;
        line-height: 1.05;
        display: block;
      }

      .entry-description {
        font-family: var(--type);
        font-size: 0.95rem;
        margin-top: 0.4rem;
        max-width: 38rem;
        display: block;
        line-height: 1.55;
      }

      .entry-arrow {
        font-family: var(--display);
        font-size: 1.6rem;
        transition: transform 0.15s ease;
      }

      .entry-link:hover .entry-arrow {
        transform: translateX(0.3rem);
      }

      /* ---------- posts ---------- */
      .posts {
        list-style: none;
        display: grid;
        gap: 1.5rem;
        grid-template-columns: 1fr;
      }

      .post {
        position: relative;
      }

      .post:nth-child(odd) {
        transform: rotate(-0.4deg);
      }

      .post:nth-child(even) {
        transform: rotate(0.3deg);
      }

      .post-link {
        display: block;
        background: var(--paper-deep);
        border: 3px solid var(--ink);
        padding: 1.25rem 1.5rem 1.5rem;
        text-decoration: none;
        color: var(--ink);
        position: relative;
        transition:
          transform 0.15s ease,
          box-shadow 0.15s ease;
      }

      .post-link:hover {
        transform: translate(-4px, -4px);
        box-shadow: 8px 8px 0 0 var(--ink);
      }

      .post-meta {
        display: flex;
        gap: 1rem;
        margin-bottom: 0.5rem;
        font-family: var(--type);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }

      .post-meta .pin {
        background: var(--red);
        color: var(--paper);
        padding: 0.1rem 0.4rem;
        font-family: var(--display);
        font-size: 0.7rem;
      }

      .post-title {
        font-family: var(--display);
        font-size: clamp(1.25rem, 2.3vw, 1.65rem);
        text-transform: uppercase;
        line-height: 1.05;
        margin-bottom: 0.4rem;
      }

      .post-description {
        font-family: var(--type);
        font-size: 0.95rem;
      }

      .all-essays {
        display: inline-block;
        margin-top: 1.75rem;
        font-family: var(--display);
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        text-decoration: none;
        background: var(--ink);
        color: var(--paper);
        padding: 0.85rem 1.5rem;
        border: 3px solid var(--ink);
      }

      .all-essays:hover {
        background: var(--paper);
        color: var(--ink);
      }

      /* ---------- subscribe ---------- */
      .subscribe-block {
        background: var(--ink);
        color: var(--paper);
        border: 3px solid var(--ink);
        padding: 1.75rem;
        margin-top: 1rem;
        position: relative;
      }

      .subscribe-block::before {
        content: "✶ JOIN ✶";
        position: absolute;
        top: -1.1rem;
        left: 1rem;
        background: var(--red);
        color: var(--paper);
        padding: 0.2rem 0.7rem;
        font-family: var(--display);
        font-size: 0.85rem;
        letter-spacing: 0.1em;
      }

      .subscribe-blurb {
        font-family: var(--type);
        font-size: 1rem;
        margin-bottom: 1rem;
      }

      .substack-frame {
        background: var(--paper);
        padding: 0.6rem;
      }

      /* ---------- footer ---------- */
      .colophon {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 6px solid var(--ink);
        font-family: var(--type);
      }

      .colophon-row {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
        align-items: baseline;
        flex-wrap: wrap;
      }

      .colophon-label {
        font-family: var(--display);
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--red);
      }

      .colophon-links {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .colophon-links a {
        text-decoration: none;
        border: 2px solid var(--ink);
        padding: 0.3rem 0.6rem;
        font-family: var(--display);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        transition:
          background 0.15s ease,
          color 0.15s ease;
      }

      .colophon-links a:hover {
        background: var(--ink);
        color: var(--paper);
      }

      .colophon-links a.back {
        background: var(--red);
        color: var(--paper);
      }

      .colophon-blessing {
        font-family: var(--display);
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin: 1.5rem 0 0.85rem;
        color: var(--ink);
      }

      .colophon-note {
        font-family: var(--type);
        font-size: 0.82rem;
        color: var(--ink-soft);
      }

      .colophon-note .red {
        color: var(--red);
      }

      /* ---------- entrance ---------- */
      @keyframes punch {
        0% {
          opacity: 0;
          transform: translateY(8px) scale(0.98);
        }
        100% {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .barcode,
      .masthead-issue,
      .masthead-title,
      .masthead-tagline,
      .stamp,
      .nav,
      .hero {
        animation: punch 0.45s cubic-bezier(0.4, 1.4, 0.4, 1) both;
      }

      .masthead-issue {
        animation-delay: 0.05s;
      }
      .masthead-title {
        animation-delay: 0.12s;
      }
      .masthead-tagline {
        animation-delay: 0.22s;
      }
      .stamp {
        animation-delay: 0.5s;
        animation-duration: 0.3s;
      }
      .nav {
        animation-delay: 0.32s;
      }
      .hero {
        animation-delay: 0.42s;
      }

      /* ---------- mobile ---------- */
      @media (max-width: 800px) {
        .hero {
          grid-template-columns: 1fr;
          gap: 3rem;
        }

        .hero-photo-wrap {
          max-width: 320px;
          margin: 0 auto;
        }

        .photo-caption {
          bottom: -1.8rem;
        }

        .stamp {
          right: 0;
          font-size: 0.85rem;
        }

        .nav {
          font-size: 0.78rem;
        }

        .nav a {
          padding: 0.7rem 0.6rem;
          flex: 1 1 50%;
          border-bottom: 3px solid var(--ink);
        }

        .nav a:nth-child(2),
        .nav a:nth-child(4) {
          border-right: none;
        }

        .nav a:nth-child(3),
        .nav a:nth-child(4) {
          border-bottom: none;
        }

        .entry-link {
          grid-template-columns: 3rem 1fr;
        }

        .entry-arrow {
          display: none;
        }

        .entry-number {
          font-size: 2.2rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="barcode">
      <div class="barcode-marquee">
        <span>Issue 04</span>
        <span>Vol. I</span>
        <span>Free / Take One</span>
      </div>
      <div class="barcode-marquee">
        <span>Adityaaswani.com</span>
      </div>
    </div>

    <main>
      <header class="masthead">
        <div class="masthead-issue">
          <span>No. 04 — <strong>Spring 2026</strong></span>
          <span>For the Dogs</span>
        </div>
        <h1 class="masthead-title">
          ADI<span class="strike">TYA</span><br />
          <span class="red">ASWANI</span>
        </h1>
        <p class="masthead-tagline">
          A WRITER, A BUDDHIST, A FELONY DEFENDANT — printing the truth from a
          borrowed kitchen table in Brooklyn.
        </p>
        <div class="stamp">
          FELONY<br /><small>CASE NO. 2024CF1118</small>
        </div>
      </header>

      <nav class="nav">
        <a href="#work">/ WORK</a>
        <a href="#writing">/ WRITING</a>
        <a href="/contact/">/ CONTACT</a>
        <a href={heroLinks.petition} class="alert" target="_blank" rel="noopener noreferrer">/ SIGN PETITION</a>
      </nav>

      <section class="hero">
        <div>
          <h2 class="hero-headline">
            They <span class="red underline">took a dog</span> from my arms.<br
            />Now I face a <span class="red">felony charge</span>.
          </h2>
          <div class="lede">
            This site is the desk where I keep the work: <strong
              >the case</strong
            > I&rsquo;m defending in court, the <strong>sanghas</strong> I help run,
            and the <strong>essays</strong> I publish about meditation, animal liberation,
            and the slow collisions between practice and the world.
          </div>
          <div class="actions">
            <a class="btn btn-red" href={heroLinks.essay} target="_blank" rel="noopener noreferrer"
              >READ THE ESSAY →</a
            >
            <a class="btn" href={heroLinks.petition} target="_blank" rel="noopener noreferrer"
              >SIGN PETITION ✶</a
            >
          </div>
        </div>

        <div class="hero-photo-wrap">
          <div class="photo-frame">
            <span class="tape tape-1"></span>
            <img src="/aditya-640.webp" alt="Aditya Aswani" />
            <span class="tape tape-2"></span>
          </div>
          <div class="photo-caption">↳ ADITYA · BROOKLYN · 2025</div>
        </div>
      </section>

      <div class="rule-bar">
        <h2><span class="num">§ 01.</span> WHAT I&rsquo;M DOING</h2>
      </div>

      <ol class="entries" id="work">
        {
          projects.map((project) => (
            <li class="entry">
              <a
                class="entry-link"
                href={project.link}
                target={project.link.startsWith("http") ? "_blank" : null}
                rel={
                  project.link.startsWith("http")
                    ? "noopener noreferrer"
                    : null
                }
              >
                <span class="entry-number">{project.number}</span>
                <span>
                  <span class="entry-title">{project.title}</span>
                  <span class="entry-description">{project.description}</span>
                </span>
                <span class="entry-arrow">▸</span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="rule-bar">
        <h2><span class="num">§ 02.</span> DISPATCHES</h2>
      </div>

      <ol class="posts" id="writing">
        {
          posts.map((post, i) => (
            <li class="post">
              <a
                class="post-link"
                href={post.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="post-meta">
                  {i === 0 && <span class="pin">NEW</span>}
                  <span>{post.date}</span>
                </div>
                <h3 class="post-title">{post.title}</h3>
                <p class="post-description">{post.description}</p>
              </a>
            </li>
          ))
        }
      </ol>

